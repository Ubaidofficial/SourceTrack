---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Header from "./partials/Header.astro";

const gtmEnabled = config.google_tag_manager?.enable;
const gtmId = config.google_tag_manager?.gtm_id;

// Font families routed through Astro's font pipeline. Families named in
// theme.json's `self_hosted` array are excluded: they ship as a real file under
// public/fonts with their own @font-face in src/styles/fonts.css, and astro.config
// already omits them from `fonts`, so asking <Font> for one would look up a family
// the pipeline never registered.
// `new Set<string>` explicitly, NOT inferred. theme.json's self_hosted array is EMPTY as of
// v1.5 (all three families are OFL and go through the provider), and TypeScript infers an
// empty JSON array as `never[]` — so an inferred Set is `Set<never>` and `.has(key: string)`
// fails to compile. It type-checked while the array had an entry and broke the moment it was
// emptied, which is why this annotation has to stay even if a family is self-hosted again.
const selfHostedFonts = new Set<string>(theme.fonts.self_hosted || []);
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type") && !selfHostedFonts.has(key),
);

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  structuredData?: any[];
}

const { title, meta_title, description, image, noindex, canonical, structuredData = [] } =
  Astro.props;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "SourceTrack",
  "url": "https://www.sourcetrack.ai",
  "logo": "https://www.sourcetrack.ai/images/logo.png",
  "sameAs": [
    "https://github.com/Ubaidofficial/SourceTrack"
  ],
  "description": "Privacy-first marketing attribution and lightweight web analytics for founders and SaaS teams."
};

const allSchemas = [orgSchema, ...structuredData];
---

<!doctype html>
<html lang="en">
  <head>
    {/* No theme bootstrap. The marketing site is light-only (design.md §3.1);
        the product app keeps both themes and is a separate build with its own
        `darkMode: 'class'` Tailwind config — nothing here reaches it.

        A returning visitor may still hold a `theme` key in localStorage from the
        removed toggle. It is inert: nothing writes a theme attribute onto <html>
        and no stylesheet keys off one, so the page renders light regardless of
        what that key says. Deliberately NOT clearing it — a cleanup script would
        re-introduce the storage read this removal exists to delete, to tidy a
        value nothing can observe. */}
    <!-- Google Tag Manager -->
    {gtmEnabled && (
      <script is:inline define:vars={{ gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer', gtmId);
      </script>
    )}
    {/* Icons — the SourceTrack mark, ported from dashboard/src/components/Logo.jsx
        (LogoIcon), replacing the vendor theme's purple AI-sparkle PNG.
        Size-split on purpose: the full mark's 2.8/80 strokes render sub-pixel at
        16px and mush into a blob, so 16px gets a simplified glyph — same lime
        tile, same two journey nodes, ring and cursor dropped. 32px and up carry
        the full geometry verbatim. */}
    <link rel="icon" type="image/svg+xml" href={config.site.favicon} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- theme meta -->
    <meta name="theme-name" content="sourcetrack-astro" />
    <meta name="msapplication-TileColor" content="#000000" />
    {/* One theme-color, unconditionally. This previously carried an OS-preference
        media condition and the ink value, which made the browser chrome follow the
        visitor's operating system while the page itself followed the (now removed)
        toggle — the two could disagree. On a light-only site the correct value is
        the page background, with no media condition at all. */}
    <meta name="theme-color" content="#F7F4ED" />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css -->
    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <!-- canonical url -->
    <link rel="canonical" href={canonical ? canonical : `https://www.sourcetrack.ai${Astro.url.pathname}`} item-prop="url" />

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- author -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- og-title -->
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- og-description -->
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={`${config.site.base_url}/${Astro.url.pathname.replace("/", "")}`}
    />

    <!-- twitter-title -->
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />

    <!-- twitter-description -->
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- og-image -->
    <meta
      property="og:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />

    <!-- twitter-image -->
    <meta
      name="twitter:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- JSON-LD Structured Data -->
    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <ClientRouter />

    <script>
      /*
       * prefers-reduced-motion — JS layer (design.md §21).
       *
       * CSS cannot reach script-driven motion, and this site has a lot of it:
       * the WAAPI `animate()` calls in ~15 .astro component scripts (Hero,
       * Badge, BlogCard, IconBox, SectionHeader, Social, PricingCard,
       * FeaturedPost, KeyFeatures, …) and every React `motion` island.
       *
       * `MotionGlobalConfig.skipAnimations` makes motion apply ONLY the final
       * keyframe, so those elements land in their end state with no
       * interpolation — a hard stop, not a shortened animation, and content
       * still ends up visible (all of these animate opacity 0 -> 1 from a
       * resting state of opacity 1).
       *
       * Declared in <head> so it runs before any component script creates an
       * animation; the flag is read at animation-creation time.
       */
      import { MotionGlobalConfig } from "motion";

      const query = window.matchMedia("(prefers-reduced-motion: reduce)");
      const sync = () => {
        MotionGlobalConfig.skipAnimations = query.matches;
      };

      sync();
      query.addEventListener("change", sync);
    </script>

    <noscript>
      <style>
        /*
         * Scroll-reveal safety net for the React motion islands.
         *
         * The .astro reveals no longer ship a hidden state: their SSR markup renders fully
         * visible and their own scripts apply opacity:0 before observing. The React islands
         * cannot do that — `motion`'s `initial="hidden"` / `initial={{opacity:0}}` is
         * serialised INTO the server HTML, so FAQ/Accordion, Statistics, Pricing, Integration
         * and OpenPositions ship as style="opacity:0;transform:translateY(20px)" and stay that
         * way until the island hydrates and IntersectionObserver fires.
         *
         * With scripting off that never happens, so the copy is permanently invisible while its
         * container, borders and buttons render normally — the exact symptom that started this.
         * Nothing animates without JS anyway, so forcing every inline-hidden element visible
         * here costs no motion and recovers the content.
         *
         * SCOPE, deliberately narrow:
         *   - opacity only. `transform` is NOT reset: Tailwind positions several of these with
         *     class-based transforms (-translate-x-1/2 and friends) and a blanket
         *     `transform:none !important` would drag them out of place.
         *   - .price-tag is excluded. Pricing's monthly/yearly tags are absolutely stacked and
         *     the inactive one is hidden ON PURPOSE; revealing it prints both prices on top of
         *     each other, which on a pricing page is worse than the thing being fixed.
         *   - .kf-arrow needs no exclusion: it is width:0 inside overflow-hidden, so opacity
         *     alone cannot expose it.
         *
         * LIMIT, stated rather than implied: this covers scripting-disabled only. A page where
         * JS runs but `motion` fails to load, or which is captured without a scroll event, keeps
         * the React islands hidden — <noscript> does not apply there. Closing that needs the
         * reveal state moved out of `initial` and behind a script-added marker class across the
         * six React components; that changes how those animations are authored and is not folded
         * in here.
         */
        [style*="opacity:0"]:not(.price-tag) {
          opacity: 1 !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    {gtmEnabled && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        />
      </noscript>
    )}
    <TwSizeIndicator />
    <Header  />
    <main id="main-content" transition:animate="fade">
      <slot />
    </main>
    <Footer  />
  </body>
</html>
