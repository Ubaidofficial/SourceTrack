---
import AnimatedButton from "@/components/AnimatedButton.astro";
import CTAShape from "@/components/shape/CTAShape";
interface Props {
  data: any;
}
const { data } = Astro.props;
const uid = `cta-${Math.random().toString(36).slice(2, 8)}`;
---

{data.frontmatter.enable && (
  <section class="relative overflow-hidden">
    <div class="main-container">
      <div class="container">
        <div id={uid} class="container-padding-y text-center">
          <h1 class="mb-5 hero-text sm:w-4/6 mx-auto">{data.frontmatter.title}</h1>
          <p class="text-lg mb-10 sm:w-3/6 mx-auto">{data.frontmatter.description}</p>
          <div class="mt-10 flex justify-center gap-4">
            {data.frontmatter.button?.enable && (
              <AnimatedButton href={data.frontmatter.button.link} classNames="btn btn-primary">
                {data.frontmatter.button.label}
              </AnimatedButton>
            )}
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 -z-10">
      <CTAShape />
    </div>
  </section>
)}

<script>
  // The hide here is JS-only — nothing in the markup above is styled invisible — so scripting
  // being OFF was never the risk. Working JS was: `el.style.opacity = "0"` ran immediately and
  // only an IntersectionObserver callback could undo it, so an observer that never fired left
  // this CTA permanently invisible on a page where everything else worked. revealOnScroll keeps
  // the animation and adds a viewport-checked sweep that cannot leave it stranded.
  import { revealOnScroll } from "@/lib/revealOnScroll";
  function initCTAs() {
    document.querySelectorAll<HTMLElement>('[id^="cta-"]').forEach((el) => {
      revealOnScroll(el, { opacity: [0, 1], transform: ["translateY(20px)", "translateY(0)"] }, { duration: 0.5, ease: "easeInOut" });
    });
  }
  document.addEventListener("astro:page-load", initCTAs);
</script>
