---
// TrustBar partial — "Works with" integration logos strip + generic incoming webhook reframe.
// Uses real SVGs from /public/images/integrations/ (Stripe, Shopify, GTM, WordPress, Webflow, Framer).
// Reframed: Includes incoming webhook receiver (forms, chat, CRMs) per Item 1.
//
// ── TWO MECHANISMS, AND THE COPY MUST NOT MERGE THEM ────────────────────────────────
// Scheduling used to sit inside the webhook sentence, which told visitors to configure a
// webhook for something the tracker already does unaided. Embedded Calendly and Cal.com
// bookings are detected by the shipped tracker (tracker/tracker.js:1202-1238) and, since
// #592, promoted to a real $conversion with conversion_type 'meeting'. Before #592 this
// claim would have been false in effect — detection happened but nothing read the event —
// which is why the reframe was held back until that landed.
//
// "EMBEDDED" IS LOAD-BEARING, NOT FILLER. Calendly detection reads origin-validated
// postMessage from the embedded iframe; Cal.com hooks window.Cal only when the embed
// snippet is on the page. A link-only flow that redirects the visitor to calendly.com is
// NOT auto-detected — it stays UTM passthrough (tracker.js:1161-1163). Unqualified
// "Calendly bookings are detected automatically" would be false for every link-only
// customer, so the qualifier must survive copy edits. GTM §5.1 / design.md §29.7.
//
// The "chat" mention in this line is the INCOMING-WEBHOOK claim and is deliberately
// untouched here — feat/chat-tracking-phase1 edits that clause. See this PR's body.
const integrations = [
  { name: "Stripe", logo: "/images/integrations/stripe.svg" },
  { name: "Shopify", logo: "/images/integrations/shopify.svg" },
  { name: "Google Tag Manager", logo: "/images/integrations/gtm.svg" },
  { name: "WordPress", logo: "/images/integrations/wordpress.svg" },
  { name: "Webflow", logo: "/images/integrations/webflow.svg" },
  { name: "Framer", logo: "/images/integrations/framer.svg" },
];
---

<section class="py-12 border-y border-[#3D3830] bg-[#1B1811]">
  <div class="main-container">
    <div class="container px-4 text-center">
      <p class="text-xs font-bold uppercase tracking-widest text-[#A79E8C] mb-6">
        Works with your existing stack, and any tool that can send a webhook
      </p>
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12 mb-6">
        {
          integrations.map((item) => (
            <div class="flex items-center gap-2 text-xs font-semibold text-[#F6F3EB]">
              <img
                src={item.logo}
                alt={item.name}
                width="24"
                height="24"
                class="h-6 w-auto object-contain"
                loading="lazy"
                decoding="async"
              />
              <span>{item.name}</span>
            </div>
          ))
        }
      </div>
      <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1.5 text-xs text-primary font-medium">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <span>Embedded Calendly and Cal.com bookings are detected automatically. Any tool that can send a webhook connects too: forms, chat, and CRMs</span>
      </div>
    </div>
  </div>
</section>
