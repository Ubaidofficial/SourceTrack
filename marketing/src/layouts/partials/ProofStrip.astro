---
// ProofStrip partial — side-by-side concrete proof visuals for AI referral tracking
// and Search Console organic revenue. Replaces the full KeyFeatures sticky stack
// while preserving visual proof for the comparison table's assertions (Change 4).
import AiSourceLedgerMockup from "@/components/AiSourceLedgerMockup.astro";
import SeoRevenueMockup from "@/components/SeoRevenueMockup.astro";
---

{/* §2.7 POSITION 5 — FRAMELESS GRID, ACCENT BORDER. The two cells already carry the
    accent (border-t-2 border-t-primary/50) and are deliberately NOT cards and NOT
    window frames — position 4 immediately above is the window frame, and repeating it
    here is exactly what §2.7 bars.

    The surface is now OPAQUE. It was `bg-[#18150F]/70`, and 70% dark over the paper page
    composites to a mid-grey that the #A79E8C body copy could not clear: 2.67:1 against
    a 4.5 requirement. The raw hex looked safe; the rendered surface was not. Opaque
    #18150F takes the same copy to 6.86:1 with no colour change to the text itself. */}
<section class="relative overflow-hidden py-20 border-y border-[#3D3830] bg-[#1B1F1F]">
  <div class="main-container">
    <div class="container px-4">
      <div class="mb-12 text-center">
        <div class="bg-gradient-primary p-px inline-block rounded-full mb-2">
          <div class="bg-gradient-black-grid px-4 py-1.5 rounded-full">
            <span class="gradient-text-primary">Concrete Proof</span>
          </div>
        </div>
        <h2 class="text-h2 font-medium lg:w-3/5 mx-auto text-[#F2F4F3]">
          Attribution depth you can inspect row by row
        </h2>
        <p class="text-lg mt-4 lg:w-3/5 mx-auto text-[#A8AFAF]">
          Track AI referrals with ranked lead and revenue totals, and match Search Console organic landing pages against actual conversions.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-2 items-start max-w-[1100px] mx-auto">
        <div class="rounded-2xl border-t-2 border-t-primary/50 border-x border-b border-[#3D3830] bg-[#1F2323] p-3 shadow-lg">
          <AiSourceLedgerMockup />
        </div>
        <div class="rounded-2xl border-t-2 border-t-primary/50 border-x border-b border-[#3D3830] bg-[#1F2323] p-3 shadow-lg">
          <SeoRevenueMockup />
        </div>
      </div>
    </div>
  </div>
</section>
