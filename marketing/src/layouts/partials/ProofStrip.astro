---
// ProofStrip partial — side-by-side concrete proof visuals for AI referral tracking
// and Search Console organic revenue. Replaces the full KeyFeatures sticky stack
// while preserving visual proof for the comparison table's assertions (Change 4).
import AiSourceLedgerMockup from "@/components/AiSourceLedgerMockup.astro";
import SeoRevenueMockup from "@/components/SeoRevenueMockup.astro";
---

<section class="relative overflow-hidden py-16">
  <div class="main-container">
    <div class="container px-4">
      <div class="mb-10 text-center">
        <div class="bg-gradient-primary p-px inline-block rounded-full mb-2">
          <div class="bg-gradient-black-grid px-4 py-1.5 rounded-full">
            <span class="gradient-text-primary">Concrete Proof</span>
          </div>
        </div>
        <h2 class="text-h2 font-medium lg:w-3/5 mx-auto">
          Attribution depth you can inspect row by row
        </h2>
        <p class="text-lg mt-4 lg:w-3/5 mx-auto text-gray">
          Track AI referrals with ranked lead and revenue totals, and match Search Console organic landing pages against actual conversions.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-2 items-start max-w-[1100px] mx-auto">
        <div class="rounded-3xl border border-white/10 bg-[#12100C]/80 p-2 shadow-2xl">
          <AiSourceLedgerMockup />
        </div>
        <div class="rounded-3xl border border-white/10 bg-[#12100C]/80 p-2 shadow-2xl">
          <SeoRevenueMockup />
        </div>
      </div>
    </div>
  </div>
</section>
