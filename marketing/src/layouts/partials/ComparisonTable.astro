// Every cell verified against GTM §3 per-competitor truth table.
// No competitor logos (design.md §35.3 compliant). Text column headers only.
---

<section class="py-20 relative overflow-hidden bg-[#12100C]/60 border-y border-white/5">
  <div class="main-container">
    <div class="container px-4">
      <div class="mb-12 text-center">
        <div class="bg-gradient-primary p-px inline-block rounded-full mb-2">
          <div class="bg-gradient-black-grid px-4 py-1.5 rounded-full">
            <span class="gradient-text-primary">Feature Comparison</span>
          </div>
        </div>
        <h2 class="text-h2 font-medium lg:w-3/5 mx-auto">
          How SourceTrack compares on attribution depth & privacy
        </h2>
