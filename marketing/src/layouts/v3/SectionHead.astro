---
/**
 * V3 SectionHead — eyebrow + heading + optional lede.
 *
 * Appears on 11 of the design's 12 pages, which is why it is a component rather
 * than repeated markup.
 *
 * The eyebrow is `--v3-gray-700` on a light surface: 5.96:1, comfortably AA. It
 * is NOT lime — §3.6 rules lime-on-paper at ~1.3:1, "Fail. Never — fills only."
 */
interface Props { eyebrow?: string; heading: string; lede?: string; align?: "left" | "center" }
const { eyebrow, heading, lede, align = "left" } = Astro.props
---
<div class:list={["v3-section-head", `is-${align}`]}>
  {eyebrow && <p class="v3-eyebrow">{eyebrow}</p>}
  <h2 class="v3-section-title" set:html={heading} />
  {lede && <p class="v3-section-lede">{lede}</p>}
</div>

<style>
  .v3-section-head { margin-bottom: 30px; }
  .v3-section-head.is-center { text-align: center; margin-inline: auto; }
  .v3-eyebrow {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--v3-gray-700);
  }
  .v3-section-title { margin: 0; color: var(--v3-text); text-wrap: balance; }
  .v3-section-lede {
    margin: 16px 0 0;
    max-width: 62ch;
    color: var(--v3-gray-600);
    font-size: 18px;
    line-height: 1.55;
  }
  .v3-section-head.is-center .v3-section-lede { margin-inline: auto; }
</style>
