---
/**
 * V3 Wrap — the page's horizontal container.
 *
 * RECREATED from the design handoff's `.wrap`, not lifted. The handoff declares
 * `max-width: var(--max); margin: 0 auto; padding: 0 32px` while separately
 * declaring `--gutter: 24px` — its container padding and its grid gutter are
 * different numbers. Both are carried through here as distinct tokens rather
 * than collapsed, because collapsing them would change the design's spacing
 * rhythm silently.
 */
interface Props { class?: string; as?: string }
const { class: cls = "", as = "div" } = Astro.props
const Tag = as as any
---
<Tag class:list={["v3-wrap", cls]}><slot /></Tag>

<style>
  .v3-wrap {
    max-width: var(--v3-max);
    margin-inline: auto;
    padding-inline: 32px;
  }
  @media (max-width: 900px) {
    .v3-wrap { padding-inline: var(--v3-gutter); }
  }
</style>
