---
import Badge from "@/components/Badge.astro";
interface Props {
  title: string;
  badge: string;
}
const { title, badge } = Astro.props;
const uid = `sh-${Math.random().toString(36).slice(2, 8)}`;
---

<div id={uid} class="text-center mb-14">
  {badge && <Badge>{badge}</Badge>}
  <h2 class="text-h2 font-medium lg:w-2/5 mx-auto">{title}</h2>
</div>

<script>
  // revealOnScroll, not a raw `el.style.opacity = "0"` + inView pair. #530 made this markup
  // fail open for scripting-disabled visitors, but the runtime hide still had no way back if the
  // observer never fired: measured with IntersectionObserver stubbed dead, this content stayed at
  // opacity 0 through a full scroll of the page. The helper keeps the same animation and adds the
  // viewport-checked sweep that recovers it.
  import { revealOnScroll } from "@/lib/revealOnScroll";
  function initSectionHeaders() {
    document.querySelectorAll<HTMLElement>('[id^="sh-"]').forEach((el) => {
      revealOnScroll(el, { opacity: [0, 1], transform: ["translateY(20px)", "translateY(0)"] }, { duration: 0.5, ease: "easeInOut" });
    });
  }
  document.addEventListener("astro:page-load", initSectionHeaders);
</script>
