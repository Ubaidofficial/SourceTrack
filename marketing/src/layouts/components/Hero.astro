---
import AnimatedButton from "@/components/AnimatedButton.astro";
import HeroShape from "@/components/shape/HeroShape";
import { markdownify } from "@/lib/utils/textConverter";
import JourneyTrail from "./JourneyTrail.astro";
interface Props {
  data: any;
}
const { data } = Astro.props;
---

<section class="overflow-hidden relative">
  <div class="h-full w-px bg-light/8 absolute top-0 left-1/2 -translate-x-1/2">
  </div>
  <div class="main-container">
    <div class="container px-0">
      <div class="container-padding-y pb-0 px-0">
        <!-- Editorial two-column: copy left, resolved journey right.
             Single column below md with the copy first, matching how
             WhyChooseUs/KeyFeatures stack. -->
        <div class="grid items-center gap-10 px-4 md:grid-cols-12 md:gap-12">
          <div
            class="flex flex-col items-start text-left md:col-span-7"
          >
          <!-- BADGE -->
          {
            data.badge?.enable && (
              <div
                id="hero-badge"
                class="bg-gradient-secondary p-px rounded-full mb-2"
              >
                {/* Text-only pill. This used to lead with a cluster of three stock faces
                    (avatars/avatar-1..3) presented as social proof for a product with five
                    attributed conversions — invented people vouching for it. The rendering
                    path is removed rather than emptied, and the `images` key is gone from the
                    content file, so it cannot be repopulated with another stock set.
                    The asymmetric px-1.5/pr-3 padding existed only to sit tight against those
                    avatars; without them the pill takes the same symmetric padding as every
                    other badge on the site (see Badge.astro). */}
                <div class="px-4 py-1.5 bg-gradient-black-grid rounded-full flex items-center">
                  <p class="gradient-text-primary">{data.badge.label}</p>
                </div>
              </div>
            )
          }
          <!-- TITLE -->
          <h1
            id="hero-title"
            class="hero-text mb-4"
            set:html={markdownify(data.title).__html}
          />
          <!-- CONTENT -->
          <p id="hero-content" class="text-lg">
            {data.content}
          </p>
          <!-- BUTTONS -->
          <div
            id="hero-buttons"
            class="mt-10 flex items-center gap-5 flex-wrap justify-start"
          >
            {
              data.button_dark?.enable && (
                <AnimatedButton
                  classNames="btn btn-dark"
                  href={data.button_dark?.link || "/"}
                >
                  {data.button_dark?.label}
                </AnimatedButton>
              )
            }
            {
              data.button_primary?.enable && (
                <AnimatedButton
                  classNames="btn btn-primary"
                  href={data.button_primary?.link || "/"}
                >
                  {data.button_primary?.label}
                </AnimatedButton>
              )
            }
          </div>
          </div>

          <!-- RESOLVED JOURNEY -->
          <div id="hero-journey" class="relative z-1 md:col-span-5">
            <JourneyTrail />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Hero Shape -->
  <div
    id="hero-shape"
    class="absolute bottom-20 -z-1 left-1/2 -translate-x-1/2 pointer-events-none h-100 sm:h-150 lg:h-170 xl:h-210"
  >
    <HeroShape />
  </div>
</section>

<script>
  import { animateMini as animate } from "motion";
  function initHero() {
    const smooth = { ease: "easeInOut" as const };
    const badge = document.getElementById("hero-badge");
    const title = document.getElementById("hero-title");
    const content = document.getElementById("hero-content");
    const buttons = document.getElementById("hero-buttons");
    const heroJourney = document.getElementById("hero-journey");
    const heroShape = document.getElementById("hero-shape");
    if (badge) {
      badge.style.opacity = "0";
      animate(
        badge,
        { opacity: [0, 1], transform: ["translateY(-20px)", "translateY(0)"] },
        { ...smooth, duration: 0.5, delay: 0.2 },
      );
    }
    if (title) {
      title.style.opacity = "0";
      animate(
        title,
        { opacity: [0, 1], transform: ["translateY(20px)", "translateY(0)"] },
        { ...smooth, duration: 0.8, delay: 0.3 },
      );
    }
    if (content) {
      content.style.opacity = "0";
      animate(
        content,
        { opacity: [0, 1], transform: ["translateY(20px)", "translateY(0)"] },
        { ...smooth, duration: 0.5, delay: 0.5 },
      );
    }
    if (buttons) {
      buttons.style.opacity = "0";
      animate(
        buttons,
        { opacity: [0, 1], transform: ["translateY(20px)", "translateY(0)"] },
        { ...smooth, duration: 0.5, delay: 0.6 },
      );
    }
    if (heroJourney) {
      heroJourney.style.opacity = "0";
      animate(
        heroJourney,
        { opacity: [0, 1], transform: ["translateY(40px)", "translateY(0)"] },
        { ...smooth, duration: 1.2, delay: 0.4 },
      );
      // The trail resolves one touchpoint at a time. Same fail-open contract as
      // every other element here: opacity is set from JS and animated straight
      // back, so with no JS (or no animation) the full trail is already visible.
      // Nothing is gated behind the motion — it only replays what is on screen.
      const steps = heroJourney.querySelectorAll<HTMLElement>(".journey-step");
      steps.forEach((step, i) => {
        step.style.opacity = "0";
        animate(
          step,
          { opacity: [0, 1], transform: ["translateY(8px)", "translateY(0)"] },
          { ...smooth, duration: 0.4, delay: 0.7 + i * 0.15 },
        );
      });
    }
    if (heroShape) {
      heroShape.style.opacity = "0";
      animate(
        heroShape,
        { opacity: [0, 1], transform: ["scale(0.8)", "scale(1)"] },
        { ...smooth, duration: 1.2, delay: 0.2 },
      );
    }
  }
  document.addEventListener("astro:page-load", initHero);
</script>
