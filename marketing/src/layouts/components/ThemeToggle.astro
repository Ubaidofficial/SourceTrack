---
// Light/dark toggle for the marketing nav.
//
// Deliberately NOT named ThemeSwitcher.astro: scripts/removeDarkmode.js hard-deletes
// `src/layouts/components/ThemeSwitcher.astro` by exact path (fs.unlinkSync). That
// script is dormant — referenced nowhere in package.json or CI — but one stray run
// would delete this component outright. The name is the cheap safeguard.
//
// Markup mirrors the existing #menu-toggle button in Header.astro: bare <button>,
// text-text, inline SVG with fill-current, one icon hidden at a time. No new button
// style is introduced.
//
// The theme is applied by the inline bootstrap in Base.astro <head>; this component
// only flips and persists it.
---

<button
  id="theme-toggle"
  type="button"
  class="cursor-pointer flex items-center text-text hover:text-primary transition-colors"
  aria-label="Switch theme"
  aria-live="polite"
>
  {/* Shown in light mode — click to go dark */}
  <svg class="theme-icon-dark h-5 w-5 fill-current" viewBox="0 0 20 20" aria-hidden="true">
    <title>Switch to dark theme</title>
    <path d="M10.5 2a8 8 0 1 0 7.5 10.5A6.5 6.5 0 0 1 10.5 2z"></path>
  </svg>
  {/* Shown in dark mode — click to go light */}
  <svg class="theme-icon-light h-5 w-5 fill-current hidden" viewBox="0 0 20 20" aria-hidden="true">
    <title>Switch to light theme</title>
    <path
      d="M10 14a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0-11a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0V4a1 1 0 0 1 1-1zm0 12a1 1 0 0 1 1 1v1a1 1 0 1 1-2 0v-1a1 1 0 0 1 1-1zM3 10a1 1 0 0 1 1-1h1a1 1 0 1 1 0 2H4a1 1 0 0 1-1-1zm12 0a1 1 0 0 1 1-1h1a1 1 0 1 1 0 2h-1a1 1 0 0 1-1-1zM5.05 5.05a1 1 0 0 1 1.41 0l.71.71a1 1 0 0 1-1.41 1.41l-.71-.71a1 1 0 0 1 0-1.41zm7.78 7.78a1 1 0 0 1 1.41 0l.71.71a1 1 0 0 1-1.41 1.41l-.71-.71a1 1 0 0 1 0-1.41zm2.12-7.78a1 1 0 0 1 0 1.41l-.71.71a1 1 0 1 1-1.41-1.41l.71-.71a1 1 0 0 1 1.41 0zM7.17 12.83a1 1 0 0 1 0 1.41l-.71.71a1 1 0 0 1-1.41-1.41l.71-.71a1 1 0 0 1 1.41 0z"
    ></path>
  </svg>
</button>

<script>
  // Re-bound on every astro:page-load because ClientRouter swaps the document —
  // same pattern as Badge.astro's initBadgeAnimations.
  function initThemeToggle() {
    const btn = document.getElementById("theme-toggle");
    if (!btn || btn.dataset.bound === "true") return;
    btn.dataset.bound = "true";

    const sync = () => {
      const dark =
        document.documentElement.getAttribute("data-theme") === "dark";
      btn.querySelector(".theme-icon-dark")?.classList.toggle("hidden", dark);
      btn.querySelector(".theme-icon-light")?.classList.toggle("hidden", !dark);
      btn.setAttribute(
        "aria-label",
        dark ? "Switch to light theme" : "Switch to dark theme",
      );
    };

    btn.addEventListener("click", () => {
      const next =
        document.documentElement.getAttribute("data-theme") === "dark"
          ? "light"
          : "dark";
      document.documentElement.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch (e) {
        // Private mode / storage disabled — the toggle still works for this page.
      }
      sync();
    });

    sync();
  }

  document.addEventListener("astro:page-load", initThemeToggle);
</script>
