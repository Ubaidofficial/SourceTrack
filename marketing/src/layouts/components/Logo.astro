---
import config from "@/config/config.json";
import ImageMod from "./ImageMod.astro";
import StLogo from "@/components/StLogo.astro";
interface Props {
  src?: string;
  /** §3.1: 44px in the header lockup, 48px in the footer. */
  size?: number;
}
const { src, size = 44 } = Astro.props;
const { logo, logo_width, logo_height, logo_text, title } = config.site;
const w = parseInt(String(logo_width || 0), 10) || 0;
const h = parseInt(String(logo_height || 0), 10) || 0;
const logoPath = src ?? logo;
---

{/* Mark + wordmark lockup. The mark is inlined here rather than set as config.site.logo on
    purpose: config.site.logo takes the <ImageMod> branch below, which REPLACES the text
    instead of pairing with it, and an image also escapes .navbar-brand's colour — which is
    what makes the wordmark theme-responsive in the first place. Inlining keeps the text as
    text and adds the mark beside it.
    The mark carries its own ink background and needs no theme variant. It previously also
    carried a dark-mode-only border rect, because on a #12100C body the ink square vanished
    and left two floating discs; the marketing site is light-only (design.md §3.1) so that
    case cannot arise and the rect is gone. Same geometry as
    dashboard/src/components/Logo.jsx and both favicon.svg files — the app keeps both themes
    and keeps its own equivalent handling there. */}
<a href="/" class="navbar-brand inline-flex items-center gap-2.5">
  {
    logoPath ? (
      <ImageMod
        src={logoPath}
        alt={title || "Site logo"}
        width={w * 2}
        height={h * 2}
        fetchpriority="high"
        loading="eager"
        style={`height:${h}px;width:${w}px`}
      />
    ) : (
      <>
        <StLogo size={size} />
        <span class="st-wordmark">{logo_text || title}</span>
      </>
    )
  }
</a>

<style>
  /* §3.2.1 wordmark: 23px / 900 / -0.05em, dropping to 21px at ≤740. §3.1's lockup
     gap is 11px — set on .navbar-brand rather than here so the mark and the text stay
     one unit. "Source" 700 / "Track" 900 is §3.1's weight split; it needs the wordmark
     to be two spans, which config.site.logo_text supplies as one string, so it is not
     expressed here. Recorded as the known gap rather than faked with a font-synthesis
     trick that would not match. */
  .st-wordmark {
    font-family: var(--font-primary), system-ui, sans-serif;
    font-size: 23px;
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  @media (max-width: 740px) {
    .st-wordmark { font-size: 21px; }
  }
</style>
