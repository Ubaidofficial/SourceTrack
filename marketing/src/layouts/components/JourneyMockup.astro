---
// SourceTrack Visitor Journey panel — the SECOND product surface on this page, alongside
// DashboardMockup.astro (the hero's Attribution card). Same technique on purpose: markup
// ported from the real component rather than a PNG, so the labels stay greppable, the
// chrome inherits real brand tokens, and it cannot silently drift out of date the way a
// screenshot does.
//
// Ported from dashboard/src/components/JourneyModal.jsx — the two-column layout (lime-tinted
// profile rail + session timeline), the attribution-trail chip strip (§8.6:
// [Source] -> [Landing] -> [Event] -> [Revenue]), the qualified check overlaid on the
// avatar, and the All / Conversions / AI Touches filter pills are all that component's.
//
// Two invariants carried over from the real UI rather than re-invented for marketing:
//   • The avatar is a MONO GLYPH off the visitor's short id — never a name, never a photo.
//     There is no person-level identity to draw here, and inventing one would contradict
//     the cookieless / no-de-anonymisation rule (§6).
//   • Revenue renders only where a real value exists. The sessions that did not convert
//     show no revenue at all — not "$0", not a dash (§6: no fake zeros).
//
// EVERY NUMBER HERE IS ILLUSTRATIVE and the card says so in its own header badge. It is a
// drawing of the product, not a claim about anyone's data.
const trail = [
  { label: "ChatGPT", tone: "default" },
  { label: "/compare", tone: "mono" },
  { label: "$conversion", tone: "mono" },
  { label: "$240", tone: "revenue" },
];

const stats = [
  { label: "Sessions", value: "3" },
  { label: "Conversions", value: "1" },
  { label: "Revenue", value: "$240" },
  { label: "Duration", value: "6d" },
];

const sessions = [
  {
    index: 1,
    source: "ChatGPT",
    when: "Jul 12, 09:14",
    duration: "2m 41s",
    converted: false,
    events: ["/compare", "/pricing"],
  },
  {
    index: 2,
    source: "Direct",
    when: "Jul 15, 18:02",
    duration: "1m 12s",
    converted: false,
    events: ["/docs/install"],
  },
  {
    index: 3,
    source: "Google Ads",
    when: "Jul 18, 11:27",
    duration: "4m 08s",
    converted: true,
    events: ["/pricing", "Checkout completed"],
  },
];
---

{/* overflow-x-clip contains the decorative glow below. MEASURED at 375px: the glow is
    520px wide, absolutely positioned at left-1/2 with -translate-x-1/2, so it extends
    ~73px past the viewport on each side and made documentElement.scrollWidth 447 against
    clientWidth 375 — a page that scrolls sideways on mobile.

    Fixed at the CAUSE rather than by a global `html { overflow-x: clip }`, which the
    handoff calls "belt-and-braces … not the fix" precisely because it hides the symptom
    on every future offender too.

    `clip` not `hidden`, and x-only: `overflow-x: clip` is the one value that can pair with
    `overflow-y: visible` without forcing the other axis to a scroll container, so the
    card's drop shadow still renders past the top and bottom edges. */}
<div class="relative mx-auto w-full max-w-[940px] overflow-x-clip">
  <div
    class="absolute left-1/2 top-[40px] h-[360px] w-[520px] -translate-x-1/2 rounded-full bg-primary opacity-[0.18] blur-[64px]"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative rounded-[28px] border border-white/10 bg-[#1F2323] p-3 shadow-[0_30px_90px_rgba(31,35,35,.30)]"
  >
    <div class="overflow-hidden rounded-[20px] border border-[#3D3830] bg-[#1B1F1F]">
      <!-- Window chrome -->
      <div
        class="grid h-[48px] grid-cols-[80px_1fr_auto] items-center gap-2 border-b border-white/10 bg-[#1B1F1F] px-4 text-xs font-bold text-[#F2F4F3]"
      >
        <div class="flex gap-[6px]">
          <span class="h-2.5 w-2.5 rounded-full bg-[#E54545]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#F0602A]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-primary"></span>
        </div>
        <span class="truncate">SourceTrack · Visitor Journey</span>
      </div>

      <div class="grid gap-px bg-[#3D3830] md:grid-cols-5">
        <!-- ── Profile rail ── -->
        <div class="space-y-4 bg-[#1B1F1F] p-4 md:col-span-2">
          <div>
            <p class="text-[10px] uppercase tracking-wider text-[#A8AFAF]">Profile</p>
            <div class="mt-2 flex items-center gap-2.5">
              <div class="relative flex-shrink-0">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-full border border-primary/40 bg-primary/15"
                >
                  <span class="font-mono text-xs font-bold tracking-tight text-white">A4</span>
                </div>
                <!-- Qualified badge — an ABSENT badge means "not qualified", so it is never a default -->
                <span
                  class="absolute -bottom-0.5 -right-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-[#CCF03F] ring-2 ring-[#1B1F1F]"
                  title="Qualification: QUALIFIED"
                >
                  <svg viewBox="0 0 24 24" class="h-2.5 w-2.5" fill="none" stroke="white" stroke-width="4">
                    <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
              </div>
              <div class="min-w-0">
                <h3 class="break-all font-mono text-base font-bold leading-tight text-white">a4f2c9e1</h3>
                <p class="mt-0.5 text-[10px] text-[#A8AFAF]">Anonymous visitor · no cookie set</p>
              </div>
            </div>
          </div>

          <!-- Attribution trail — scroll-scrubbed connector -->
          <div class="rounded-xl border border-[#3D3830] bg-[#282C2C] p-3" data-journey-trail>
            <p class="mb-2 text-[10px] uppercase tracking-wider text-[#A8AFAF]">Attribution trail</p>
            <div class="relative flex flex-wrap items-center gap-1">
              <!-- Connector line behind the chips — fills left-to-right with scroll -->
              <div
                class="pointer-events-none absolute left-0 top-1/2 h-[2px] w-full -translate-y-1/2 origin-left bg-primary/40"
                data-trail-connector
                style="transform: scaleX(0) translateY(-50%);"
              ></div>
              {
                trail.map((chip, i) => (
                  <span class="relative flex items-center gap-1" data-trail-step>
                    <span
                      class:list={[
                        "inline-flex max-w-[110px] items-center rounded-md border px-1.5 py-0.5 text-[10px] font-medium transition-opacity duration-300",
                        chip.tone === "revenue"
                          ? "border-primary/40 bg-primary/15 text-primary"
                          : "border-[#454038] bg-[#2B261E] text-[#F2F4F3]",
                        chip.tone === "mono" ? "font-mono" : "",
                      ]}
                    >
                      <span class="truncate">{chip.label}</span>
                    </span>
                    {i < trail.length - 1 && (
                      <svg viewBox="0 0 24 24" class="h-2.5 w-2.5 flex-shrink-0 text-[#696258]" fill="none" stroke="currentColor" stroke-width="3">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                  </span>
                ))
              }
            </div>
          </div>

          <!-- KPI grid -->
          <div class="grid grid-cols-2 gap-2">
            {
              stats.map((s) => (
                <div
                  class:list={[
                    "rounded-xl border p-2.5 text-center transition-colors",
                    s.label === "Revenue"
                      ? "border-primary/40 bg-primary/10 shadow-[0_0_12px_rgba(212,246,46,0.08)]"
                      : "border-[#3D3830] bg-[#282C2C]",
                  ]}
                >
                  <p
                    class:list={[
                      "truncate font-bold tracking-tight",
                      s.label === "Revenue"
                        ? "text-xl font-black text-primary"
                        : "text-base font-semibold text-[#A8AFAF]",
                    ]}
                  >
                    {s.value}
                  </p>
                  <p class="mt-0.5 text-[10px] uppercase tracking-wider text-[#A8AFAF]">{s.label}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- ── Session timeline ── -->
        <div class="bg-[#1B1F1F] p-4 md:col-span-3">
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-white px-3 py-1 text-[11px] font-medium text-[#1B1F1F]">All (5)</span>
            <span class="rounded-full bg-[#2B261E] px-3 py-1 text-[11px] font-medium text-[#A8AFAF]">Conversions (1)</span>
            <span class="rounded-full bg-[#2B261E] px-3 py-1 text-[11px] font-medium text-[#A8AFAF]">AI Touches (1)</span>
          </div>

          <div class="space-y-2">
            {
              sessions.map((s) => (
                <div
                  class:list={[
                    "rounded-xl border p-3",
                    s.converted ? "border-primary/40 bg-primary/8" : "border-[#3D3830] bg-[#282C2C]",
                  ]}
                >
                  <div class="flex items-start gap-3">
                    <div
                      class:list={[
                        "mt-0.5 flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full text-[10px] font-bold",
                        s.converted ? "bg-primary text-[#1B1F1F]" : "bg-[#3D3830] text-[#F2F4F3]",
                      ]}
                    >
                      #{s.index}
                    </div>

                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="text-xs font-semibold text-[#F2F4F3]">Session {s.index}</span>
                        <span class="truncate rounded bg-[#3D3830] px-1.5 py-0.5 text-[10px] font-medium text-[#A8AFAF]">
                          {s.source}
                        </span>
                        {s.converted && (
                          <span class="inline-flex items-center gap-1 rounded-full bg-primary/20 px-1.5 py-0.5 text-[10px] font-medium text-primary">
                            <svg viewBox="0 0 24 24" class="h-2.5 w-2.5" fill="currentColor">
                              <path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z" />
                            </svg>
                            Converted
                          </span>
                        )}
                      </div>
                      <div class="mt-1 flex flex-wrap items-center gap-2 text-[10px] text-[#908778]">
                        <span>{s.when}</span>
                        <span>·</span>
                        <span>{s.duration}</span>
                      </div>

                      <div class="mt-2 space-y-1">
                        {s.events.map((e) => (
                          <div class="flex items-center gap-2 text-[11px] text-[#F2F4F3]">
                            <span class="h-1 w-1 flex-shrink-0 rounded-full bg-[#696258]" />
                            <span class="truncate font-mono">{e}</span>
                          </div>
                        ))}
                      </div>
                    </div>

                    {/* Revenue shows ONLY where a real value exists — the two non-converting
                        sessions render nothing here rather than "$0" or a dash (§6). */}
                    {s.converted && <span class="flex-shrink-0 text-sm font-black text-primary">$240</span>}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { scroll } from "motion";

  function initTrailScrub() {
    const trails = document.querySelectorAll<HTMLElement>("[data-journey-trail]");
    if (!trails.length) return;

    // §37.3: prefers-reduced-motion — render fully revealed immediately, no animation
    const isReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    trails.forEach((trail) => {
      const connectorEl = trail.querySelector<HTMLElement>("[data-trail-connector]");
      const stepEls = trail.querySelectorAll<HTMLElement>("[data-trail-step]");
      if (!connectorEl || !stepEls.length) return;

      const connector: HTMLElement = connectorEl;
      const steps: NodeListOf<HTMLElement> = stepEls;
      const totalSteps = steps.length; // 4

      if (isReducedMotion) {
        connector.style.transform = "scaleX(1) translateY(-50%)";
        steps.forEach((step) => {
          step.style.opacity = "1";
        });
        return;
      }

      // Initial state: connector hidden, steps dimmed
      connector.style.transform = "scaleX(0) translateY(-50%)";
      steps.forEach((step) => {
        step.style.opacity = "0.25";
      });

      // §37.2: reveals fire ONCE, never loop — latch at 100%
      let latched = false;

      function latchFinal() {
        latched = true;
        connector.style.transform = "scaleX(1) translateY(-50%)";
        steps.forEach((step) => {
          step.style.opacity = "1";
        });
      }

      // scroll() from motion — callback form, scoped to this trail container
      // offset: animation starts when container's top hits the bottom of the viewport,
      //         ends when container's bottom reaches the center of the viewport
      const cleanup = scroll(
        (progress: number) => {
          if (latched) return;

          // Once we hit or pass 1.0, latch permanently (§37.2: no reset, no replay)
          if (progress >= 1) {
            latchFinal();
            if (cleanup) cleanup();
            return;
          }

          // Fill the connector line proportionally
          connector.style.transform = `scaleX(${progress}) translateY(-50%)`;

          // Light up steps sequentially at equal intervals
          const stepThreshold = 1 / totalSteps;
          steps.forEach((step, i) => {
            const threshold = i * stepThreshold;
            if (progress >= threshold) {
              step.style.opacity = "1";
            } else {
              step.style.opacity = "0.25";
            }
          });
        },
        {
          target: trail,
          offset: ["start end", "end center"],
        }
      );
    });
  }

  // Run on DOMContentLoaded for initial page load, and on astro:after-swap
  // for View Transitions (if used)
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTrailScrub);
  } else {
    initTrailScrub();
  }
  document.addEventListener("astro:after-swap", initTrailScrub);
</script>
