---
import Base from "@/layouts/Base.astro";
---

<Base title="Data Processing Addendum (DPA) — SourceTrack" description="GDPR Data Processing Addendum and data transfer commitments for SourceTrack customers.">
  <section className="py-16 bg-[#0E1111] text-white">
    <div className="max-w-[800px] mx-auto px-4 space-y-6">
      <h1 className="text-4xl font-black text-white">Data Processing Addendum (DPA)</h1>
      <p className="text-gray-400 text-lg">This DPA supplements our Terms of Service for customers operating under GDPR and EU data protection regulations.</p>
    </div>
  </section>
</Base>
