---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser";

const { frontmatter } = await getListPage("standalone/subprocessors.md");
const { title, description, heading, paragraph } = frontmatter;
---

<Base title={title} description={description}>
  <section class="py-16 bg-[#0E1111] text-white">
    <div class="max-w-[800px] mx-auto px-4 space-y-6">
      <h1 class="text-4xl font-black text-white">{heading}</h1>
      <p class="text-gray-400 text-lg">{paragraph}</p>
      <div class="bg-[#161719] p-6 rounded-2xl border border-[#2A2C30] space-y-4">
        <div class="flex justify-between items-center border-b border-[#2A2C30] pb-3">
          <span class="font-bold text-[#C8F000]">Supabase Inc.</span>
          <span class="text-xs text-gray-400">PostgreSQL OLTP & Authentication (USA / EU)</span>
        </div>
        <div class="flex justify-between items-center border-b border-[#2A2C30] pb-3">
          <span class="font-bold text-[#C8F000]">Tinybird Inc.</span>
          <span class="text-xs text-gray-400">ClickHouse OLAP Ingestion & Analytics Pipes</span>
        </div>
        <div class="flex justify-between items-center border-b border-[#2A2C30] pb-3">
          <span class="font-bold text-[#C8F000]">Railway Corp.</span>
          <span class="text-xs text-gray-400">API Server & Application Hosting</span>
        </div>
        <div class="flex justify-between items-center">
          <span class="font-bold text-[#C8F000]">Stripe Inc.</span>
          <span class="text-xs text-gray-400">Payment Processing & Subscription Billing</span>
        </div>
      </div>
    </div>
  </section>
</Base>
