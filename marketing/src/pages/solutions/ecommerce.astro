---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser";
import CallToAction from "@/partials/CallToAction.astro";
import MarketingBeforeAfter from "@/components/MarketingBeforeAfter";

const callToAction = await getListPage("standalone/solutions/ecommerce.md");
---

<Base
  title="SourceTrack for eCommerce & DTC — Shopify Order Attribution"
  description="Connect Google Ads, Meta Ads, and AI search to actual Shopify order revenue with cookieless cart attribute stitching."
>
  <section class="py-16 bg-[#0E1111] text-white">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="inline-block px-3 py-1 text-xs font-black uppercase tracking-widest text-[#0F1012] bg-[#D2EC2A] rounded-full">
        eCommerce & DTC Solutions
      </span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight text-white">
        Connect Ad Clicks and AI Research <br />
        <span class="text-[#D2EC2A]">To Real Shopify Orders.</span>
      </h1>
      <p class="max-w-2xl mx-auto text-gray-400 text-base sm:text-lg leading-relaxed">
        Stop losing attribution to iOS privacy restrictions and missing UTMs. Use cart attribute stitching to link store purchases to actual buyer sessions.
      </p>
    </div>
  </section>

  {/* Embedded Before / After Component */}
  <section class="py-16 bg-[#0F1012] text-white border-t border-b border-[#2A2C30]">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-8">
      <MarketingBeforeAfter mode="ecommerce" showToggle={false} client:visible />
    </div>
  </section>

  <CallToAction data={callToAction} />
</Base>
