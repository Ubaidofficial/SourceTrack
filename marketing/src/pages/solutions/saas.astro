---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser";
import CallToAction from "@/partials/CallToAction.astro";
import MarketingBeforeAfter from "@/components/MarketingBeforeAfter";

const callToAction = await getListPage("standalone/solutions/saas.md");
---

<Base
  title="SourceTrack for SaaS & B2B — AI & Multi-Touch Revenue Attribution"
  description="Know which sources, campaigns, and AI search tools drive recurring revenue and subscriptions for your SaaS product."
>
  <section class="py-16 bg-[#0E1111] text-white">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="inline-block px-3 py-1 text-xs font-black uppercase tracking-widest text-[#0F1012] bg-[#D2EC2A] rounded-full">
        SaaS & B2B Solutions
      </span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight text-white">
        Know Which Traffic Brings Signups — <br />
        <span class="text-[#D2EC2A]">And Which Brings Revenue.</span>
      </h1>
      <p class="max-w-2xl mx-auto text-gray-400 text-base sm:text-lg leading-relaxed">
        Track subscriptions, trial conversions, and MRR expansion back to originating AI searches, organic blogs, and ad campaigns.
      </p>
    </div>
  </section>

  {/* Embedded Before / After Component */}
  <section class="py-16 bg-[#0F1012] text-white border-t border-b border-[#2A2C30]">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-8">
      <MarketingBeforeAfter mode="default" showToggle={false} client:visible />
    </div>
  </section>

  <section class="py-16 bg-[#1B1811] text-white">
    <div class="max-w-[1140px] mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-[#1B1811] p-6 rounded-2xl border border-[#2A2C30] space-y-3">
        <h3 class="text-xl font-bold text-[#D2EC2A]">1. AI Referral Tracking</h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          Detect buyers who researched your software on ChatGPT or Claude before visiting your site.
        </p>
      </div>
      <div class="bg-[#1B1811] p-6 rounded-2xl border border-[#2A2C30] space-y-3">
        <h3 class="text-xl font-bold text-[#D2EC2A]">2. Multi-Touch Models</h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          Compare first-touch, last-touch, and linear models to evaluate upper-funnel content investments.
        </p>
      </div>
      <div class="bg-[#1B1811] p-6 rounded-2xl border border-[#2A2C30] space-y-3">
        <h3 class="text-xl font-bold text-[#D2EC2A]">3. Stripe Revenue Webhooks</h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          Stitch initial visits directly to recurring Stripe subscriptions without setting up complex CRMs.
        </p>
      </div>
    </div>
  </section>

  <CallToAction data={callToAction} />
</Base>
