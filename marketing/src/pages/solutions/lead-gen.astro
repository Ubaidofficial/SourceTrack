---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser";
import CallToAction from "@/partials/CallToAction.astro";

const callToAction = await getListPage("standalone/solutions/lead-gen.md");
---

<Base
  title="SourceTrack for Lead Generation — Form Submit & Qualified Lead Attribution"
  description="Know which channels, search terms, and AI prompts bring your form signups and qualified sales inquiries."
>
  <section class="py-16 bg-[#0E1111] text-white">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="inline-block px-3 py-1 text-xs font-black uppercase tracking-widest text-[#0F1012] bg-[#C8F000] rounded-full">
        Lead Generation Solutions
      </span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight text-white">
        Know Which Channels Drive Form Submits — <br />
        <span class="text-[#C8F000]">And Qualified Inquiries.</span>
      </h1>
      <p class="max-w-2xl mx-auto text-gray-400 text-base sm:text-lg leading-relaxed">
        Capture form submit events automatically, sanitize PII, and pass hidden attribution fields through to your backend or CRM.
      </p>
    </div>
  </section>

  <CallToAction data={callToAction} />
</Base>
