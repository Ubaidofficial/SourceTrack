---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser";
import CallToAction from "@/partials/CallToAction.astro";

const callToAction = await getListPage("standalone/solutions/agency.md");
---

<Base
  title="SourceTrack for Agencies — Multi-Client Portfolio Attribution"
  description="Report accurate multi-touch attribution, AI traffic growth, and organic revenue across all your client accounts."
>
  <section class="py-16 bg-[#0E1111] text-white">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="inline-block px-3 py-1 text-xs font-black uppercase tracking-widest text-[#0F1012] bg-[#CCF03F] rounded-full">
        Agency Solutions
      </span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight text-white">
        Prove ROI to Your Clients With <br />
        <span class="text-[#CCF03F]">Truthful Multi-Touch Attribution.</span>
      </h1>
      <p class="max-w-2xl mx-auto text-gray-400 text-base sm:text-lg leading-relaxed">
        Clean client reports showing AI referrals, paid ad clicks, and organic search queries linked directly to conversion value.
      </p>
    </div>
  </section>

  <CallToAction data={callToAction} />
</Base>
