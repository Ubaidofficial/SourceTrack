---
import Base from "@/layouts/Base.astro";
// R4 — homepage-only stylesheet, imported HERE rather than from main.css.
// main.css is pulled in by Base.astro, which every one of the 49 routes shares, so an
// import there put the full 3,851-line homepage design system on /pricing, /docs/* and
// everything else. Astro code-splits a page-level import, so this keeps it on / alone.
// Measured: non-homepage routes drop 61,036 B raw / 10,967 B gzip. The homepage pays a
// second stylesheet request and ~613 B more gzip (two files compress worse than one) —
// a good trade across 48 routes. No Base.astro change was needed.
import "@/styles/home-design.css";
import Hero from "@/components/Hero.astro";
import TrustBar from "@/partials/TrustBar.astro";
import DirectRescueShowcase from "@/partials/DirectRescueShowcase.astro";
import JourneyShowcase from "@/partials/JourneyShowcase.astro";
import ProofStrip from "@/partials/ProofStrip.astro";
import IconTrio from "@/partials/IconTrio.astro";
import ComparisonTable from "@/partials/ComparisonTable.astro";
import HowItWorksShowcase from "@/partials/HowItWorksShowcase.astro";
import UseCaseCards from "@/partials/UseCaseCards.astro";
import Pricing from "@/partials/Pricing";
import FAQ from "@/partials/FAQ";
import { getListPage } from "@/lib/contentParser";

const homepage = await getListPage("homepage/-index.md");
const pricing = await getListPage("sections/pricing.md");
const faq = await getListPage("sections/faq.md");
const { banner } = homepage.frontmatter;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "SourceTrack",
  "operatingSystem": "All",
  "applicationCategory": "BusinessApplication",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "49",
    "highPrice": "79",
    "offerCount": "3"
  },
  "description": "Multi-touch marketing attribution, AI search referral detection, and Search Console revenue signals."
};

// Derived from the SAME faq_list the page renders. Google requires FAQPage markup to
// match the visible content.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": (faq.frontmatter.faq_list ?? []).map((item: { question: string; answer: string }) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Base structuredData={[softwareSchema, faqSchema]}>
  <Hero data={banner} />
  <TrustBar />
  <DirectRescueShowcase />
  <JourneyShowcase />
  <ProofStrip />
  <IconTrio />
  <ComparisonTable />
  {/* §29.3 order: the product-preview cluster above (DirectRescue -> Journey ->
      ProofStrip -> IconTrio -> ComparisonTable), then how-it-works (3), then
      use-case cards (4), then pricing (5). The two land together because the spec
      pairs them: an explainer that ends without telling the reader which of them it
      applies to is half the sequence. */}
  <HowItWorksShowcase />
  <UseCaseCards />
  <Pricing data={pricing} client:visible />
  <FAQ data={faq} client:visible />
</Base>
