---
import Base from "@/layouts/Base.astro";
---

<Base title="Webflow Integration — SourceTrack Docs" description="Webflow custom head code snippet setup.">
  <section class="py-16 bg-[#0E1111] text-white">
    <div class="max-w-[800px] mx-auto px-4 space-y-6">
      <a href="/docs" class="text-xs uppercase tracking-widest font-extrabold text-[#C8F000]">&larr; Back to Docs</a>
      <h1 class="text-4xl font-black text-white">Webflow Integration Guide</h1>
      <p class="text-gray-400 text-lg">Paste your snippet into Site Settings &gt; Custom Code &gt; Head Code.</p>
    </div>
  </section>
</Base>
