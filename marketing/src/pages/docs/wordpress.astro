---
// Faithful port of dashboard/src/pages/docs/DocsWordPress.jsx — same sections in the same order
// (Who this is for -> key terms -> what you will set up -> steps, both options -> how to verify
// -> common mistakes -> next step), text verbatim. Not reworded, for the reason batch 1 recorded:
// §29.1 puts website voice under docs/SourceTrack_GTM.md, and this is technical documentation
// that already reads correctly, so a port that rewrote it would be a rewrite wearing a port's name.
//
// DELIBERATE DIFFERENCES FROM THE SOURCE:
//   1. DocsCodeBlock / DocsCallout are React components (copy-to-clipboard, site-key
//      substitution). No Astro equivalent exists, so their CHROME is re-expressed with the
//      inline markup this directory already uses. Text inside is unchanged.
//   2. The dashboard's <Link to="/developers/conversions"> becomes a plain href — the same
//      path exists on this site, so the target is unchanged, only the mechanism.
//
// The two option snippets are byte-identical in the source (only DocsCodeBlock's `lang` differs,
// html vs php, which only drove syntax highlighting). One SNIPPET const serves both rather than
// shipping the same string twice under two names.
//
// Canonical is deliberately NOT set: Base.astro derives `https://www.sourcetrack.ai{pathname}`,
// which is exactly the target DocsWordPress.jsx's canonical is repointed to in this same change.
import Base from "@/layouts/Base.astro";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sourcetrack.ai" },
    { "@type": "ListItem", "position": 2, "name": "Docs", "item": "https://www.sourcetrack.ai/docs" },
    { "@type": "ListItem", "position": 3, "name": "WordPress Setup Recipe", "item": "https://www.sourcetrack.ai/docs/wordpress" }
  ]
};

const SNIPPET = `<script async src="https://api.srctk.com/tracker.min.js" data-site-key="YOUR_SITE_KEY"></script>`;
---

<Base
  title="WordPress Setup Guide | SourceTrack Docs"
  description="Add the SourceTrack tracking pixel to WordPress manually or via header injection plugins. Learn how to troubleshoot caching issues."
  structuredData={[breadcrumbSchema]}
>
  <section class="py-16 bg-[#0E1111] text-white">
    <div class="max-w-[800px] mx-auto px-4 space-y-8">
      <div class="space-y-4">
        <a href="/docs" class="text-xs uppercase tracking-widest font-extrabold text-[#D2EC2A]">&larr; Back to Docs</a>
        <h1 class="text-4xl font-black text-white tracking-tight">WordPress Setup Recipe</h1>
        <p class="text-gray-400 text-lg leading-relaxed">
          Integrate the tracking pixel into your WordPress site to capture visitors site-wide.
        </p>
      </div>

      <section class="space-y-2">
        <h2 class="text-lg font-extrabold text-white border-b border-[#2A2C30] pb-2">Who This Is For</h2>
        <p class="text-sm text-gray-300 leading-relaxed">
          This guide is for bloggers, businesses, and creators running WordPress sites who want to
          establish attribution and track visitor campaigns site-wide.
        </p>
      </section>

      <div class="bg-[#101A24] border border-[#1E3A5F] rounded-2xl p-5">
        <h4 class="font-extrabold text-[#7CC4FF] mb-2 text-sm">Key Terms Defined:</h4>
        <ul class="list-disc pl-5 space-y-1 text-xs text-[#A8CFF0] leading-relaxed">
          <li><strong>WP Admin</strong> &mdash; the backend dashboard where you manage plugins, write pages, and configure your site settings.</li>
          <li><strong>Theme header (header.php)</strong> &mdash; the PHP template file that defines the top section of your site, including code placed inside the HTML <code class="text-[#D2EC2A]">&lt;head&gt;</code> tags.</li>
          <li><strong>Caching</strong> &mdash; storing static versions of your pages to speed up load times. When you edit code, you must clear the cache to show updates.</li>
        </ul>
      </div>

      <section class="space-y-2">
        <h2 class="text-lg font-extrabold text-white border-b border-[#2A2C30] pb-2">What You Will Set Up</h2>
        <p class="text-sm text-gray-300 leading-relaxed">
          You will install our pixel code either via a header injection plugin (recommended) or manually
          inside your active theme's template.
        </p>
      </section>

      <section class="space-y-6">
        <h2 class="text-lg font-extrabold text-white border-b border-[#2A2C30] pb-2">Steps: WordPress Integration</h2>

        <div class="space-y-4">
          <h3 class="text-sm font-extrabold text-white">Option 1: Using a Plugin (Recommended)</h3>
          <ol class="list-decimal pl-5 space-y-2 text-sm text-gray-300 leading-relaxed">
            <li>Log in to your WordPress Admin dashboard.</li>
            <li>Go to <strong>Plugins &rarr; Add New</strong> and search for <strong>WPCode</strong> (or any "Insert Headers and Footers" plugin).</li>
            <li>Install and activate the plugin.</li>
            <li>
              Navigate to the plugin settings and paste this code snippet in the <strong>Header</strong> section:
              <pre class="mt-2 bg-[#0F1012] p-4 rounded-xl text-xs text-gray-300 overflow-x-auto border border-[#2A2C30]"><code>{SNIPPET}</code></pre>
            </li>
            <li>Click <strong>Save Changes</strong>.</li>
          </ol>
        </div>

        <div class="space-y-4 pt-4 border-t border-[#2A2C30]">
          <h3 class="text-sm font-extrabold text-white">Option 2: Direct Theme Edit</h3>
          <ol class="list-decimal pl-5 space-y-2 text-sm text-gray-300 leading-relaxed">
            <li>Log in to your file manager or theme editor and open <code class="text-[#D2EC2A]">wp-content/themes/your-active-theme/header.php</code>.</li>
            <li>
              Paste the script directly before the closing <code class="text-[#D2EC2A]">&lt;/head&gt;</code> tag:
              <pre class="mt-2 bg-[#0F1012] p-4 rounded-xl text-xs text-gray-300 overflow-x-auto border border-[#2A2C30]"><code>{SNIPPET}</code></pre>
            </li>
            <li>Save the file.</li>
          </ol>
          <div class="bg-amber-400/5 border border-amber-400/25 rounded-2xl p-5 text-sm text-amber-300 leading-relaxed">
            <strong>Warning:</strong> Direct modifications to theme files will be overwritten when the
            theme updates. We strongly recommend using child themes or Option 1 (WPCode plugin).
          </div>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-lg font-extrabold text-white border-b border-[#2A2C30] pb-2">How to Verify It Worked</h2>
        <ol class="list-decimal pl-5 space-y-3 text-sm text-gray-300 leading-relaxed">
          <li>Visit your WordPress website.</li>
          <li>Open Developer Tools (right-click &rarr; Inspect), click <strong>Network</strong>, and filter by <code class="text-[#D2EC2A]">track</code>.</li>
          <li>Refresh the page. Verify a call to <code class="text-[#D2EC2A]">POST /api/track</code> completes successfully.</li>
          <li>Confirm your browser visits appear in the SourceTrack dashboard <strong>Event Debugger</strong>.</li>
        </ol>
      </section>

      <section class="space-y-4">
        <h2 class="text-lg font-extrabold text-white border-b border-[#2A2C30] pb-2">Common Mistakes</h2>
        <ul class="list-disc pl-5 space-y-2 text-sm text-gray-300 leading-relaxed">
          <li>
            <strong>Active Cache Blocker:</strong> If you use cache plugins (e.g. WP Rocket, W3 Total
            Cache, Autoptimize), you must clear your site cache after saving changes. Otherwise, visitors
            will continue loading the old HTML page without the script.
          </li>
          <li>
            <strong>Minification Exclusions:</strong> If your caching plugin bundles JavaScript, it may
            break script loading. Exclude <code class="text-[#D2EC2A]">tracker.min.js</code> from
            minification / defer lists if errors occur in your browser console.
          </li>
        </ul>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-extrabold text-white border-b border-[#2A2C30] pb-2">Next Step</h2>
        <p class="text-sm text-gray-300 leading-relaxed">
          Setup is complete! You can now track custom conversion goals (like contact form submits or
          checkout buy clicks) by reviewing the
          <a href="/developers/conversions" class="text-[#D2EC2A] font-bold hover:underline">Browser Conversions guide</a>.
        </p>
      </section>
    </div>
  </section>
</Base>
