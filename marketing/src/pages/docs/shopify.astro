---
import Base from "@/layouts/Base.astro";
---

<Base
  title="Shopify Integration Guide — SourceTrack Docs"
  description="Theme liquid snippet and cart attribute setup for tracking Shopify orders."
>
  <section class="py-16 bg-[#0E1111] text-white">
    <div class="max-w-[800px] mx-auto px-4 space-y-6">
      <a href="/docs" class="text-xs uppercase tracking-widest font-extrabold text-[#C8F000]">&larr; Back to Docs</a>
      <h1 class="text-4xl font-black text-white">Shopify Integration Guide</h1>
      <p class="text-gray-400 text-lg">Embed our script in your theme.liquid layout file and add cart attribute handlers.</p>
      <div class="bg-[#161719] p-6 rounded-2xl border border-[#2A2C30] space-y-4">
        <h3 class="font-bold text-[#C8F000]">Theme Layout Snippet</h3>
        <pre class="bg-[#0F1012] p-4 rounded-xl text-xs text-gray-300 overflow-x-auto"><code>{`<script src="https://api.srctk.com/tracker/tracker.min.js" data-site-key="YOUR_SITE_KEY" async></script>`}</code></pre>
      </div>
    </div>
  </section>
</Base>
