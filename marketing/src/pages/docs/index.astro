---
import Base from "@/layouts/Base.astro";
---

<Base
  title="SourceTrack Documentation & Integration Guides"
  description="Step-by-step installation guides, platform walkthroughs, and setup recipes for SourceTrack."
>
  <section class="py-16 bg-[#0E1111] text-white">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="inline-block px-3 py-1 text-xs font-black uppercase tracking-widest text-[#0F1012] bg-[#C8F000] rounded-full">
        Documentation Home
      </span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight text-white">
        SourceTrack Docs & <br />
        <span class="text-[#C8F000]">Platform Guides</span>
      </h1>
      <p class="max-w-2xl mx-auto text-gray-400 text-base sm:text-lg leading-relaxed">
        Everything you need to set up tracking, connect payment gateways, and start inspecting customer journeys in minutes.
      </p>
    </div>
  </section>

  <section class="py-16 bg-[#161719] text-white">
    <div class="max-w-[1140px] mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/docs/quickstart" class="bg-[#1C1D20] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#C8F000] transition-colors block">
        <h3 class="text-lg font-bold text-[#C8F000]">⚡ Quickstart Guide</h3>
        <p class="text-sm text-gray-400 mt-2">Get up and running in under 5 minutes with our single script snippet.</p>
      </a>
      <a href="/docs/install" class="bg-[#1C1D20] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#C8F000] transition-colors block">
        <h3 class="text-lg font-bold text-[#C8F000]">📄 HTML & Pixel Setup</h3>
        <p class="text-sm text-gray-400 mt-2">Standard pixel installation guide for custom web applications.</p>
      </a>
      <a href="/docs/shopify" class="bg-[#1C1D20] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#C8F000] transition-colors block">
        <h3 class="text-lg font-bold text-[#C8F000]">🛒 Shopify Integration</h3>
        <p class="text-sm text-gray-400 mt-2">Theme liquid snippet and cart attribute setup for order attribution.</p>
      </a>
      <a href="/docs/wordpress" class="bg-[#1C1D20] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#C8F000] transition-colors block">
        <h3 class="text-lg font-bold text-[#C8F000]">🌐 WordPress Setup</h3>
        <p class="text-sm text-gray-400 mt-2">Add SourceTrack to your WordPress header or Theme File Editor.</p>
      </a>
      <a href="/docs/webflow" class="bg-[#1C1D20] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#C8F000] transition-colors block">
        <h3 class="text-lg font-bold text-[#C8F000]">🎨 Webflow Guide</h3>
        <p class="text-sm text-gray-400 mt-2">Custom head code snippet setup for Webflow sites.</p>
      </a>
      <a href="/docs/gtm" class="bg-[#1C1D20] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#C8F000] transition-colors block">
        <h3 class="text-lg font-bold text-[#C8F000]">🏷️ Google Tag Manager</h3>
        <p class="text-sm text-gray-400 mt-2">Custom HTML tag deployment using GTM container triggers.</p>
      </a>
      <a href="/docs/framer" class="bg-[#1C1D20] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#C8F000] transition-colors block">
        <h3 class="text-lg font-bold text-[#C8F000]">✨ Framer Integration</h3>
        <p class="text-sm text-gray-400 mt-2">Custom code section setup for Framer landing pages.</p>
      </a>
      <a href="/docs/stripe" class="bg-[#1C1D20] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#C8F000] transition-colors block">
        <h3 class="text-lg font-bold text-[#C8F000]">💳 Stripe Webhooks</h3>
        <p class="text-sm text-gray-400 mt-2">Connect Stripe payment events and charge webhooks for recurring revenue attribution.</p>
      </a>
      <a href="/docs/troubleshooting" class="bg-[#1C1D20] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#C8F000] transition-colors block">
        <h3 class="text-lg font-bold text-[#C8F000]">🔧 Troubleshooting</h3>
        <p class="text-sm text-gray-400 mt-2">Diagnostic tools, tracking doctor checks, and common installation fixes.</p>
      </a>
    </div>
  </section>
</Base>
