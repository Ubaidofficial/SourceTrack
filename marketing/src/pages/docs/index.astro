---
// Hub copy lives in content/standalone/docs-hub.md; the seven glossary terms are one file each
// in the `glossary` collection. Still verbatim from GLOSSARY in DocsHome.jsx — two bodies carry
// inline <code>, kept as HTML strings and rendered with set:html exactly as before.
//
// The nine link cards below stay inline: they are route navigation, and this batch is scoped to
// page copy. docs/index.astro is the ONE page in this directory the docs-mirror parity guard
// deliberately excludes (DocsHome's card grid derives from docsManifest.js, so it is not shared
// prose) — which is why it can move to a content model while its ten siblings currently cannot.
//
// The card grid is still NOT ported from DocsHome.jsx, which derives its cards from
// dashboard/src/components/docs/docsManifest.js: porting it would mean either duplicating that
// manifest here (a second list to drift) or porting the manifest itself.
import Base from "@/layouts/Base.astro";
import { getCollection } from "astro:content";
import { getListPage } from "@/lib/contentParser";

const { frontmatter } = await getListPage("standalone/docs-hub.md");
const { title, description, badge, heading, heading_accent, paragraph, glossary_heading } = frontmatter;

const GLOSSARY = (await getCollection("glossary"))
  .map((e: any) => e.data)
  .sort((a: any, b: any) => a.order - b.order);
---

<Base
  title={title}
  description={description}
>
  <section class="py-16 bg-[#0E1111] text-white">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="inline-block px-3 py-1 text-xs font-black uppercase tracking-widest text-[#0F1012] bg-[#D2EC2A] rounded-full">
        {badge}
      </span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight text-white">
        {heading} <br />
        <span class="text-[#D2EC2A]">{heading_accent}</span>
      </h1>
      <p class="max-w-2xl mx-auto text-gray-400 text-base sm:text-lg leading-relaxed">
        {paragraph}
      </p>
    </div>
  </section>

  <section class="py-16 bg-[#1B1811] text-white">
    <div class="max-w-[1140px] mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/docs/quickstart" class="bg-[#1B1811] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#D2EC2A] transition-colors block">
        <h3 class="text-lg font-bold text-[#D2EC2A]">⚡ Quickstart Guide</h3>
        <p class="text-sm text-gray-400 mt-2">Get up and running in under 5 minutes with our single script snippet.</p>
      </a>
      <a href="/docs/install" class="bg-[#1B1811] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#D2EC2A] transition-colors block">
        <h3 class="text-lg font-bold text-[#D2EC2A]">📄 HTML & Pixel Setup</h3>
        <p class="text-sm text-gray-400 mt-2">Standard pixel installation guide for custom web applications.</p>
      </a>
      <a href="/docs/shopify" class="bg-[#1B1811] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#D2EC2A] transition-colors block">
        <h3 class="text-lg font-bold text-[#D2EC2A]">🛒 Shopify Integration</h3>
        <p class="text-sm text-gray-400 mt-2">Theme liquid snippet and cart attribute setup for order attribution.</p>
      </a>
      <a href="/docs/wordpress" class="bg-[#1B1811] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#D2EC2A] transition-colors block">
        <h3 class="text-lg font-bold text-[#D2EC2A]">🌐 WordPress Setup</h3>
        <p class="text-sm text-gray-400 mt-2">Add SourceTrack to your WordPress header or Theme File Editor.</p>
      </a>
      <a href="/docs/webflow" class="bg-[#1B1811] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#D2EC2A] transition-colors block">
        <h3 class="text-lg font-bold text-[#D2EC2A]">🎨 Webflow Guide</h3>
        <p class="text-sm text-gray-400 mt-2">Custom head code snippet setup for Webflow sites.</p>
      </a>
      <a href="/docs/gtm" class="bg-[#1B1811] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#D2EC2A] transition-colors block">
        <h3 class="text-lg font-bold text-[#D2EC2A]">🏷️ Google Tag Manager</h3>
        <p class="text-sm text-gray-400 mt-2">Custom HTML tag deployment using GTM container triggers.</p>
      </a>
      <a href="/docs/framer" class="bg-[#1B1811] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#D2EC2A] transition-colors block">
        <h3 class="text-lg font-bold text-[#D2EC2A]">✨ Framer Integration</h3>
        <p class="text-sm text-gray-400 mt-2">Custom code section setup for Framer landing pages.</p>
      </a>
      <a href="/docs/stripe" class="bg-[#1B1811] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#D2EC2A] transition-colors block">
        <h3 class="text-lg font-bold text-[#D2EC2A]">💳 Stripe Webhooks</h3>
        <p class="text-sm text-gray-400 mt-2">Connect Stripe payment events and charge webhooks for recurring revenue attribution.</p>
      </a>
      <a href="/docs/troubleshooting" class="bg-[#1B1811] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#D2EC2A] transition-colors block">
        <h3 class="text-lg font-bold text-[#D2EC2A]">🔧 Troubleshooting</h3>
        <p class="text-sm text-gray-400 mt-2">Diagnostic tools, tracking doctor checks, and common installation fixes.</p>
      </a>
    </div>
  </section>

  <section class="py-16 bg-[#0E1111] text-white">
    <div class="max-w-[1140px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-[#1B1811] border border-[#2A2C30] rounded-2xl p-6 sm:p-8 space-y-4">
        <h2 class="text-lg font-extrabold text-white border-b border-[#2A2C30] pb-2">
          {glossary_heading}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-4">
          {GLOSSARY.map((g) => (
            <div class="space-y-1">
              <h3 class="text-sm font-bold text-white">{g.term}</h3>
              <p class="text-xs text-gray-400 leading-relaxed" set:html={g.body} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>
