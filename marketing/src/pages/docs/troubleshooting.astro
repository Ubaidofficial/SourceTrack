---
import Base from "@/layouts/Base.astro";
---

<Base title="Tracking Troubleshooting & Diagnostics — SourceTrack Docs" description="Troubleshooting pixel verification errors, CORS issues, and missing event logs.">
  <section className="py-16 bg-[#0E1111] text-white">
    <div className="max-w-[800px] mx-auto px-4 space-y-6">
      <a href="/docs" className="text-xs uppercase tracking-widest font-extrabold text-[#C8F000]">&larr; Back to Docs</a>
      <h1 className="text-4xl font-black text-white">Troubleshooting & Tracking Diagnostics</h1>
      <p className="text-gray-400 text-lg">Verify script status, inspect network requests, and debug ingestion errors.</p>
    </div>
  </section>
</Base>
