---
/**
 * COMPARE / GA4 — promoted from /v3; indexable. This REPLACED the v2 /compare/ga4.
 *
 * §35.3/§35.4: "GA4" appears as TEXT ONLY. No Google brand mark, no logo, no
 * favicon fetch — the handoff does the same and it is the correct treatment.
 * §3.4's implementation note bars hot-linking a third-party asset per row, and
 * the same reasoning applies to a competitor's mark on a comparison page.
 *
 * §2 is the design's drag-to-compare slider, rendered as a STATIC split. The
 * slider is an interactive island and islands are Phase 6; more importantly
 * §37.1 requires motion to depict real behaviour, and a drag handle on a
 * non-functional slider would depict nothing.
 *
 * Every claim about SourceTrack comes from main. Claims about GA4 are limited to
 * its documented default behaviour — that untagged and referrer-stripped traffic
 * lands in "direct / (none)" — which is observable rather than asserted.
 */
import Base from "@/layouts/Base.astro";
import Wrap from "@/layouts/v3/Wrap.astro";
import SectionHead from "@/layouts/v3/SectionHead.astro";
import StatRow from "@/layouts/v3/StatRow.astro";
import "@/styles/v3-tokens.css";
import "@/styles/v3-home.css";
import "@/styles/v3-pages.css";

const stats = [
  { value: "16", label: "AI assistants and answer engines classified on arrival" },
  { value: "9", label: "attribution models on one first-party dataset" },
  { value: "1", label: "script tag, no tag manager required" },
  { value: "28", label: "day free trial, no card" },
];

// Rows describe SourceTrack from main, and GA4 only by its documented default.
const rows = [
  { what: "Untagged AI assistant traffic", ga4: "Lands in direct / (none)", st: "Classified against 16 named assistants" },
  { what: "Revenue attached to a session", ga4: "Requires ecommerce tagging", st: "Stripe & Shopify webhooks, first-party" },
  { what: "Re-credit under another model", ga4: "Not available in the default report", st: "Nine models, one dataset, no re-tagging" },
  { what: "Pre-form touchpoints", ga4: "Session-scoped", st: "Full journey to the conversion" },
  { what: "Cookies", ga4: "Cookie-based by default", st: "Cookieless by default, DNT and GPC honoured" },
  { what: "Install", ga4: "Tag manager typical", st: "One script tag" },
];
---

<Base
  title="The GA4 alternative built for revenue, not pageviews — SourceTrack"
  description="Same week, same traffic, two different stories. See what a revenue-first attribution view shows that a default GA4 report cannot."
>
  <div class="v3">
    {/* 1 — hero */}
    <section class="v3-hero">
      <Wrap>
        <h1>Same data. Two very different stories.</h1>
        <p class="v3-hero-sub">
          One tool counts pageviews. The other tells you which channel paid for
          itself. Run them side by side — most teams do.
        </p>
      </Wrap>
    </section>

    {/* 2 — static compare split (the design's drag slider; see the header note) */}
    <section class="v3-section v3-section--tight">
      <Wrap>
        <div class="v3-compare-split">
          <div class="v3-compare-panel">
            <h3>Default analytics report</h3>
            <p class="v3-compare-value">direct / (none)</p>
            <p>The largest single line in most accounts. It is not a channel — it is everything the tool could not classify.</p>
          </div>
          <div class="v3-compare-panel">
            <h3>SourceTrack revenue view</h3>
            <p class="v3-compare-value">Revenue by source</p>
            <p>The same sessions, resolved against referrer, click IDs and 16 named AI assistants, then credited under the model you pick.</p>
          </div>
        </div>
      </Wrap>
    </section>

    {/* 3 — stat band */}
    <section class="v3-section v3-section--tight">
      <Wrap><StatRow stats={stats} /></Wrap>
    </section>

    {/* 4 — soft band, comparison table */}
    <section class="v3-section v3-section--soft">
      <Wrap>
        <SectionHead
          eyebrow="Side by side"
          heading="Feature by feature, honestly."
          lede="Where a default analytics report is genuinely fine, this table says so. It is a different job, not a worse tool."
        />
        <div class="v3-table-card">
          <table>
            <thead><tr><th>Question</th><th>Default GA4 report</th><th>SourceTrack</th></tr></thead>
            <tbody>
              {rows.map((r) => (
                <tr><th scope="row">{r.what}</th><td>{r.ga4}</td><td>{r.st}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </Wrap>
    </section>

    {/* 5 — prose on paper */}
    <section class="v3-section">
      <Wrap>
        <SectionHead
          eyebrow="Why it matters"
          heading="It's not features. It's the story you can tell your board."
          lede="“Direct grew 40%” is not a story anyone can act on. “AI assistants produced a quarter of new revenue this month” is."
        />
      </Wrap>
    </section>

    {/* 6 — full-bleed dark. Non-adjacent to any other dark treatment on this page. */}
    <section class="v3-section v3-section--dark">
      <Wrap>
        <SectionHead
          eyebrow="Migration"
          heading="Migrate in an afternoon."
          lede="Keep your existing analytics for traffic volume. Add one script tag, connect a form source, and watch the first attributed session land."
        />
      </Wrap>
    </section>

    {/* 7 — CTA close on paper. Lime on the button only (§2.6). */}
    <section class="v3-cta-close">
      <Wrap>
        <div class="v3-cta-inner">
          <div>
            <h2>Stop staring at “direct / (none)”.</h2>
            <p>28 days free, no card. Install the script and see where that traffic actually came from.</p>
          </div>
          <div class="v3-cta-actions">
            <a class="v3-btn-accent" href="https://app.sourcetrack.ai/signup">Start 28-day free trial</a>
          </div>
        </div>
        <p class="v3-disclosure">Product visuals shown use illustrative data.</p>
      </Wrap>
    </section>
  </div>
</Base>
