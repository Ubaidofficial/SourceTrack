---
import Base from "@/layouts/Base.astro";
---

<Base title="Security & Compliance — SourceTrack" description="Security architecture, RLS tenant isolation, and data protection practices.">
  <section className="py-16 bg-[#0E1111] text-white">
    <div className="max-w-[800px] mx-auto px-4 space-y-6">
      <h1 className="text-4xl font-black text-white">Security Architecture & Isolation</h1>
      <p className="text-gray-400 text-lg">SourceTrack enforces Row-Level Security (RLS) across all database tables to guarantee multi-tenant data isolation.</p>
    </div>
  </section>
</Base>
