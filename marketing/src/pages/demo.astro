---
import RealDemoApp from "@/components/v3/demo/RealDemoApp";

const title = "Interactive Product Demo — SourceTrack";
const description = "Explore sample analytics, multi-touch source attribution, AI referral tracking, and stitched visitor journeys in this live interactive demo.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow" />
    <style is:inline>
      html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        background: #F4F5F1;
        overflow: hidden;
      }
      #demo-root {
        height: 100%;
        width: 100%;
      }
    </style>
  </head>
  <body>
    <div id="demo-root">
      <RealDemoApp client:load start="dashboard" full={true} />
    </div>
  </body>
</html>
