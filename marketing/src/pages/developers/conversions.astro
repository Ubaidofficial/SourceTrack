---
import Base from "@/layouts/Base.astro";
---

<Base title="Server Ingestion API — SourceTrack Developers" description="REST API reference for POST /api/v1/event.">
  <section className="py-16 bg-[#0E1111] text-white">
    <div className="max-w-[800px] mx-auto px-4 space-y-6">
      <a href="/developers" className="text-xs uppercase tracking-widest font-extrabold text-[#C8F000]">&larr; Back to Developers</a>
      <h1 className="text-4xl font-black text-white">Server Event Ingestion API</h1>
      <p className="text-gray-400 text-lg">POST event payloads from server-side Node, Python, or Go backends.</p>
    </div>
  </section>
</Base>
