---
import Base from "@/layouts/Base.astro";
---

<Base title="Outbound Webhooks — SourceTrack Developers" description="HMAC-signed webhook payloads and signature verification.">
  <section className="py-16 bg-[#0E1111] text-white">
    <div className="max-w-[800px] mx-auto px-4 space-y-6">
      <a href="/developers" className="text-xs uppercase tracking-widest font-extrabold text-[#C8F000]">&larr; Back to Developers</a>
      <h1 className="text-4xl font-black text-white">Outbound Webhooks & HMAC Signatures</h1>
      <p className="text-gray-400 text-lg">Receive real-time conversion notifications with sha256 HMAC verification signatures.</p>
    </div>
  </section>
</Base>
