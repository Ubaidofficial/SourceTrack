---
import Base from "@/layouts/Base.astro";
---

<Base title="Campaign Costs API — SourceTrack Developers" description="Import ad spend and campaign cost metrics into SourceTrack.">
  <section className="py-16 bg-[#0E1111] text-white">
    <div className="max-w-[800px] mx-auto px-4 space-y-6">
      <a href="/developers" className="text-xs uppercase tracking-widest font-extrabold text-[#C8F000]">&larr; Back to Developers</a>
      <h1 className="text-4xl font-black text-white">Campaign Cost Ingestion API</h1>
      <p className="text-gray-400 text-lg">Push custom ad spend and campaign costs to calculate accurate CAC and ROAS metrics.</p>
    </div>
  </section>
</Base>
