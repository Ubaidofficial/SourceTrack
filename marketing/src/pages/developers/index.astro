---
import Base from "@/layouts/Base.astro";
---

<Base
  title="SourceTrack Developer API & SDK Reference"
  description="API endpoints, client SDK methods, webhook payloads, and ingestion parameters."
>
  <section className="py-16 bg-[#0E1111] text-white">
    <div className="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span className="inline-block px-3 py-1 text-xs font-black uppercase tracking-widest text-[#0F1012] bg-[#C8F000] rounded-full">
        Developer API
      </span>
      <h1 className="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight">
        Developer API & <br />
        <span className="text-[#C8F000]">Custom Event Methods</span>
      </h1>
      <p className="max-w-2xl mx-auto text-gray-400 text-base sm:text-lg leading-relaxed">
        Full technical specification for client-side window.sourcetrack methods, server-side conversion webhooks, and REST APIs.
      </p>
    </div>
  </section>

  <section className="py-16 bg-[#161719] text-white">
    <div className="max-w-[1140px] mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/developers/tracker" className="bg-[#1C1D20] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#C8F000] transition-colors block">
        <h3 className="text-lg font-bold text-[#C8F000]">JS Tracker API</h3>
        <p className="text-sm text-gray-400 mt-2">window.sourcetrack method signatures and custom event tracking.</p>
      </a>
      <a href="/developers/identify" className="bg-[#1C1D20] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#C8F000] transition-colors block">
        <h3 className="text-lg font-bold text-[#C8F000]">Identify Method</h3>
        <p className="text-sm text-gray-400 mt-2">Link anonymous visitors to customer emails upon login or signup.</p>
      </a>
      <a href="/developers/conversions" className="bg-[#1C1D20] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#C8F000] transition-colors block">
        <h3 className="text-lg font-bold text-[#C8F000]">Server Ingestion API</h3>
        <p className="text-sm text-gray-400 mt-2">POST /api/v1/event endpoint parameters and payload schemas.</p>
      </a>
      <a href="/developers/webhooks" className="bg-[#1C1D20] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#C8F000] transition-colors block">
        <h3 className="text-lg font-bold text-[#C8F000]">Outbound Webhooks</h3>
        <p className="text-sm text-gray-400 mt-2">HMAC-signed webhook payloads dispatched on verified conversions.</p>
      </a>
      <a href="/developers/offline-conversions" className="bg-[#1C1D20] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#C8F000] transition-colors block">
        <h3 className="text-lg font-bold text-[#C8F000]">Offline Conversions</h3>
        <p className="text-sm text-gray-400 mt-2">Import offline deal closures and phone leads back to originating campaigns.</p>
      </a>
      <a href="/developers/campaign-costs" className="bg-[#1C1D20] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#C8F000] transition-colors block">
        <h3 className="text-lg font-bold text-[#C8F000]">Campaign Costs API</h3>
        <p className="text-sm text-gray-400 mt-2">Push custom ad spend and campaign cost metrics to compute CAC.</p>
      </a>
      <a href="/developers/api" className="bg-[#1C1D20] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#C8F000] transition-colors block">
        <h3 className="text-lg font-bold text-[#C8F000]">REST API Reference</h3>
        <p className="text-sm text-gray-400 mt-2">Authentication, bearer tokens, rate limits, and response envelope schemas.</p>
      </a>
      <a href="/developers/security" className="bg-[#1C1D20] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#C8F000] transition-colors block">
        <h3 className="text-lg font-bold text-[#C8F000]">Developer Security</h3>
        <p className="text-sm text-gray-400 mt-2">Row-Level Security (RLS) tenant isolation and SSRF security controls.</p>
      </a>
    </div>
  </section>
</Base>
