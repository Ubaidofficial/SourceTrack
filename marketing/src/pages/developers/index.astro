---
// Hero copy comes from content/developers/-index.md. The eight link cards below are still
// inline: they are route navigation, and the dispatch scoped Tier 1 to each page's four hero
// strings. Extracting them is a clean follow-up.
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser";

const { frontmatter } = await getListPage("developers/-index.md");
const { title, description, badge, heading, heading_accent, paragraph } = frontmatter;
---

<Base title={title} description={description}>
  <section class="py-16 bg-[#0E1111] text-white">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="inline-block px-3 py-1 text-xs font-black uppercase tracking-widest text-[#0F1012] bg-[#CCF03F] rounded-full">
        {badge}
      </span>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight text-white">
        {heading} <br />
        <span class="text-[#CCF03F]">{heading_accent}</span>
      </h1>
      <p class="max-w-2xl mx-auto text-gray-400 text-base sm:text-lg leading-relaxed">
        {paragraph}
      </p>
    </div>
  </section>

  <section class="py-16 bg-[#1B1F1F] text-white">
    <div class="max-w-[1140px] mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/developers/tracker" class="bg-[#1B1F1F] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#CCF03F] transition-colors block">
        <h3 class="text-lg font-bold text-[#CCF03F]">JS Tracker API</h3>
        <p class="text-sm text-gray-400 mt-2">window.sourcetrack method signatures and custom event tracking.</p>
      </a>
      <a href="/developers/identify" class="bg-[#1B1F1F] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#CCF03F] transition-colors block">
        <h3 class="text-lg font-bold text-[#CCF03F]">Identify Method</h3>
        <p class="text-sm text-gray-400 mt-2">Link anonymous visitors to customer emails upon login or signup.</p>
      </a>
      <a href="/developers/conversions" class="bg-[#1B1F1F] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#CCF03F] transition-colors block">
        <h3 class="text-lg font-bold text-[#CCF03F]">Server Ingestion API</h3>
        <p class="text-sm text-gray-400 mt-2">POST /api/v1/event endpoint parameters and payload schemas.</p>
      </a>
      <a href="/developers/webhooks" class="bg-[#1B1F1F] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#CCF03F] transition-colors block">
        <h3 class="text-lg font-bold text-[#CCF03F]">Outbound Webhooks</h3>
        <p class="text-sm text-gray-400 mt-2">HMAC-signed webhook payloads dispatched on verified conversions.</p>
      </a>
      <a href="/developers/offline-conversions" class="bg-[#1B1F1F] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#CCF03F] transition-colors block">
        <h3 class="text-lg font-bold text-[#CCF03F]">Offline Conversions</h3>
        <p class="text-sm text-gray-400 mt-2">Import offline deal closures and phone leads back to originating campaigns.</p>
      </a>
      <a href="/developers/campaign-costs" class="bg-[#1B1F1F] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#CCF03F] transition-colors block">
        <h3 class="text-lg font-bold text-[#CCF03F]">Campaign Costs API</h3>
        <p class="text-sm text-gray-400 mt-2">Push custom ad spend and campaign cost metrics to compute CAC.</p>
      </a>
      <a href="/developers/api" class="bg-[#1B1F1F] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#CCF03F] transition-colors block">
        <h3 class="text-lg font-bold text-[#CCF03F]">REST API Reference</h3>
        <p class="text-sm text-gray-400 mt-2">Authentication, bearer tokens, rate limits, and response envelope schemas.</p>
      </a>
      <a href="/developers/security" class="bg-[#1B1F1F] p-6 rounded-2xl border border-[#2A2C30] hover:border-[#CCF03F] transition-colors block">
        <h3 class="text-lg font-bold text-[#CCF03F]">Developer Security</h3>
        <p class="text-sm text-gray-400 mt-2">Row-Level Security (RLS) tenant isolation and SSRF security controls.</p>
      </a>
    </div>
  </section>
</Base>
