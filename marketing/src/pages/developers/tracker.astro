---
import Base from "@/layouts/Base.astro";
---

<Base title="JS Tracker API — SourceTrack Developers" description="Client-side JavaScript API reference for window.sourcetrack.">
  <section class="py-16 bg-[#0E1111] text-white">
    <div class="max-w-[800px] mx-auto px-4 space-y-6">
      <a href="/developers" class="text-xs uppercase tracking-widest font-extrabold text-[#C8F000]">&larr; Back to Developers</a>
      <h1 class="text-4xl font-black text-white">JS Tracker API Reference</h1>
      <div class="bg-[#161719] p-6 rounded-2xl border border-[#2A2C30]">
        <pre class="bg-[#0F1012] p-4 rounded-xl text-xs text-gray-300 overflow-x-auto"><code>{`window.sourcetrack('track', 'purchase', { value: 99.00, currency: 'USD' });`}</code></pre>
      </div>
    </div>
  </section>
</Base>
