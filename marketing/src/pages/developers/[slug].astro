---
// Replaces the eight per-page files under developers/ (api, campaign-costs, conversions,
// identify, offline-conversions, security, tracker, webhooks) — deleted in this same commit,
// so neither a duplicate route nor a 404 window exists at any point.
//
// Markup below is the deleted files' markup verbatim. Six of them carried a paragraph and two
// (identify, tracker) carried a code sample instead — both are optional here, so each page
// renders exactly what it rendered before.
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";

export async function getStaticPaths() {
  const pages = await getSinglePage("developers");
  return pages.map((page: any) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { title, description, heading, paragraph, code } = page.data;
---

<Base title={title} description={description}>
  <section class="py-16 bg-[#0E1111] text-white">
    <div class="max-w-[800px] mx-auto px-4 space-y-6">
      <a href="/developers" class="text-xs uppercase tracking-widest font-extrabold text-[#C8F000]">&larr; Back to Developers</a>
      <h1 class="text-4xl font-black text-white">{heading}</h1>
      {paragraph && <p class="text-gray-400 text-lg">{paragraph}</p>}
      {code && (
        <div class="bg-[#161719] p-6 rounded-2xl border border-[#2A2C30]">
          <pre class="bg-[#0F1012] p-4 rounded-xl text-xs text-gray-300 overflow-x-auto"><code>{code}</code></pre>
        </div>
      )}
    </div>
  </section>
</Base>
