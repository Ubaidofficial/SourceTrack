---
import Base from "@/layouts/Base.astro";
---

<Base title="Offline Conversions API — SourceTrack Developers" description="Import offline sales, phone leads, and CRM conversion events into SourceTrack.">
  <section className="py-16 bg-[#0E1111] text-white">
    <div className="max-w-[800px] mx-auto px-4 space-y-6">
      <a href="/developers" className="text-xs uppercase tracking-widest font-extrabold text-[#C8F000]">&larr; Back to Developers</a>
      <h1 className="text-4xl font-black text-white">Offline Conversion Ingestion</h1>
      <p className="text-gray-400 text-lg">POST offline sales, qualified phone leads, and back-office deal closures back to original visitor sessions.</p>
    </div>
  </section>
</Base>
