---
import Base from "@/layouts/Base.astro";
import PostSingle from "@/layouts/PostSingle.astro";
import { getSinglePage } from "@/lib/contentParser.astro";

export async function getStaticPaths() {
  const posts = await getSinglePage("blog");
  return posts.map((post: any) => ({
    params: { single: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

if (post.data.draft) return Astro.redirect("/404");

const { title, meta_title, description, image, date, author } = post.data;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description || "",
  "image": image ? `https://www.sourcetrack.ai${image}` : "https://www.sourcetrack.ai/images/og-image.png",
  "datePublished": date ? new Date(date).toISOString() : new Date().toISOString(),
  "author": {
    "@type": "Person",
    "name": author?.name || "SourceTrack Team"
  },
  "publisher": {
    "@type": "Organization",
    "name": "SourceTrack",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.sourcetrack.ai/images/logo.png"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sourcetrack.ai" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.sourcetrack.ai/blog" },
    { "@type": "ListItem", "position": 3, "name": title, "item": `https://www.sourcetrack.ai/blog/${post.id}` }
  ]
};
---

<Base title={title} meta_title={meta_title} description={description} image={image} structuredData={[articleSchema, breadcrumbSchema]}>
  <PostSingle post={post} />
</Base>
