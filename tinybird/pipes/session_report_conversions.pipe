DESCRIPTION >
    Wave 3 tier-3 row-pull. Conversion rows (distinct_id, timestamp) for the session-report
    converting-sessions metric — the convSql in getSessionReport
    (api/lib/attribution-engine.js:914-927, queryName 'session_report_conversions').
    Faithful 1:1 port: 2 columns in destructure order, half-open window (>= from AND < to),
    ORDER BY distinct_id ASC, timestamp ASC, LIMIT 50000.
    Typed-column translation (SCOPE_v3 §2.6): properties.site_id -> site_id, event -> event_type;
    utm_*/country/device_type/ai_source/referrer/conversion_type are typed columns.
    DYNAMIC FILTERS: the live code appends ${filterClauses} built from the `filters` object
    (:841-880) — reproduced here as {% if defined %} blocks so an omitted filter adds no
    predicate (queryTinybirdPipe drops undefined params, so the block is skipped). The `channel`
    filter is the inline multiIf channel-classifier snapshot from :844-859, translated typed;
    it is a point-in-time copy of that route's inline classifier (NOT channel-classifier.js) —
    if :844-859 changes, this block must be updated in lockstep.
    NOT YET PUSHED — authored only (token lacks WORKSPACE:DEPLOY); founder deploys.

NODE session_report_conversions_node
SQL >
    %
    SELECT
        distinct_id,
        timestamp
    FROM events
    WHERE site_id = {{ String(site_id, required=True) }}
      AND event_type = '$conversion'
      AND timestamp >= {{ DateTime(date_from_ts, required=True) }}
      AND timestamp < {{ DateTime(date_to_ts, required=True) }}
      {% if defined(filter_channel) %}
      AND COALESCE(
        multiIf(
          ai_source IS NOT NULL AND ai_source != '', 'AI Search',
          lower(COALESCE(utm_medium, '')) IN ('cpc','ppc','paid','paid_search','sem'), 'Paid Search',
          lower(COALESCE(utm_medium, '')) IN ('paid_social','paidsocial','social_paid'), 'Paid Social',
          lower(COALESCE(utm_medium, '')) IN ('email','newsletter'), 'Email',
          lower(COALESCE(utm_medium, '')) IN ('social','organic_social'), 'Organic Social',
          lower(COALESCE(utm_medium, '')) IN ('organic','seo'), 'Organic Search',
          lower(COALESCE(utm_source, '')) IN ('google','bing','duckduckgo','yahoo','brave') AND lower(COALESCE(utm_medium, '')) NOT IN ('cpc','ppc','paid','paid_search','sem'), 'Organic Search',
          lower(COALESCE(utm_source, '')) IN ('facebook','instagram','linkedin','twitter','x','tiktok','youtube','reddit') AND lower(COALESCE(utm_medium, '')) NOT IN ('paid_social','paidsocial','social_paid'), 'Organic Social',
          lower(COALESCE(utm_source, '')) IN ('mailchimp','klaviyo','hubspot','sendgrid','customer.io'), 'Email',
          referrer IS NULL OR referrer = '', 'Direct',
          'Referral'
        ),
        'Other'
      ) = {{ String(filter_channel, required=True) }}
      {% end %}
      {% if defined(filter_conversion_type) %}
      AND conversion_type = {{ String(filter_conversion_type, required=True) }}
      {% end %}
      {% if defined(filter_source) %}
      AND utm_source = {{ String(filter_source, required=True) }}
      {% end %}
      {% if defined(filter_medium) %}
      AND utm_medium = {{ String(filter_medium, required=True) }}
      {% end %}
      {% if defined(filter_campaign) %}
      AND utm_campaign = {{ String(filter_campaign, required=True) }}
      {% end %}
      {% if defined(filter_country) %}
      AND country = {{ String(filter_country, required=True) }}
      {% end %}
      {% if defined(filter_device_type) %}
      AND device_type = {{ String(filter_device_type, required=True) }}
      {% end %}
    ORDER BY distinct_id ASC, timestamp ASC
    LIMIT 50000

TYPE endpoint
