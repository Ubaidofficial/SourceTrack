PORT=3000

# ── Server base URLs ──────────────────────────────────────────────────────────
# Public base URL of the frontend/app (used in generated install snippets and
# links when no TRACKER_BASE_URL is provided).
FRONTEND_URL=

# Public base URL serving /tracker/tracker.min.js. If unset, falls back to
# FRONTEND_URL, then to http://localhost:PORT. Set this when your app, API,
# and tracker are served from different origins.
# Optional — defaults to FRONTEND_URL.
TRACKER_BASE_URL=

# Public API URL (used by deploy scripts and server-generated links when the API
# origin differs from the frontend).
# Optional.
API_URL=

# Comma-separated list of allowed staging hosts that bypass canonical redirects in dashboard serving.
# Optional.
STAGING_HOSTS=

# ── Tracker ───────────────────────────────────────────────────────────────────
# Secret salt for cookieless visitor/tracker IDs. Must be set in production.
# In development a fallback is used with a console warning.
# Required in production.
TRACKER_SALT=

# ── Webhooks ──────────────────────────────────────────────────────────────────
# Optional webhook destination for conversion event forwarding.
# If unset, no webhooks are sent.
WEBHOOK_URL=
POSTHOG_API_KEY=
POSTHOG_HOST=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# PostHog Ingestion Batching (optimizes connection scaling under load)
# Default for production/staging: flushAt = 20, flushInterval = 10000ms.
# Default for dev/test: flushAt = 1, flushInterval = 0 (immediate flush).
POSTHOG_FLUSH_AT=
POSTHOG_FLUSH_INTERVAL_MS=
# ── Supabase ──────────────────────────────────────────────────────────────────
# Staging Supabase ref: nrsvpwzekfrdrzkoecfk
# Production Supabase ref: zxjjjsipafojhzkkumvh
# Safety Guard: The local/dev API refuses to boot if NODE_ENV !== 'production' and
# SUPABASE_URL targets the production ref. Staging schema/bootstrap must be run.
# Stripe E2E remains blocked until schema/bootstrap, real staging service-role key,
# local/dev production boot guard, and Stripe test catalog are corrected.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
ALLOWED_ORIGINS=
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
KIMI_API_KEY=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Per-plan price IDs — create one recurring price per plan in Stripe dashboard.
# Add a `pv_limit` metadata key to each price (e.g. "50000") to override the
# plan's default monthly pageview cap. The free plan has no env var — it lives
# entirely in code (api/lib/plan-features.js).
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_SCALE=
# Legacy env vars — still read as fallbacks for GROWTH / SCALE respectively.
STRIPE_PRICE_ID_BUSINESS=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_AGENCY=
# Legacy single-price fallback (still supported)
STRIPE_PRICE_ID=
# Early Bird Annual founding offer — $99/year, maps to Starter-level access.
# Create a recurring annual price in Stripe, set pv_limit metadata = "25000".
# If unset, early_bird_annual checkout fails with a safe public error (no silent fallback).
STRIPE_EARLY_BIRD_ANNUAL_PRICE_ID=

# ── Encryption ────────────────────────────────────────────────────────────────
# Symmetric key for encrypting customer webhook secrets (Stripe, Shopify).
# Required in production — server crashes on startup without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: This key MUST remain stable. It must be backed up securely outside
# the repository and cloud provider config. Never commit it to git.
# CRITICAL: Losing this key breaks decryption of existing customer integration tokens
# and secrets. Changing it will require all clients to reconnect their integrations.
ENCRYPTION_KEY=

# ── Conversion API (CAPI) ─────────────────────────────────────────────────────
# Meta: set only in real production — omit to disable test event code
META_TEST_EVENT_CODE=

# Google Ads: OAuth2 access token (NOT the developer token).
# Get via: https://developers.google.com/google-ads/api/docs/oauth/overview
# 1h TTL — rotate via cron or refresh token flow.
GOOGLE_ADS_ACCESS_TOKEN=

# ── Email reports (Resend) ────────────────────────────────────────────────────
# API key from the Resend console. Required to authorize cron email jobs.
# Do not hardcode or commit production secrets.
# Sender domain verification expectations:
# - Dispatches from: reports@sourcetrack.ai and usage@sourcetrack.ai.
# - DNS SPF, DKIM, and DMARC records must be verified directly in the Resend
#   Dashboard console. No automatic DNS checking is performed by the application.
RESEND_API_KEY=

# ── Operational ───────────────────────────────────────────────────────────────
# Slack webhook for system health diagnoses and nightly job alerts.
# Slack alerts are optional but highly recommended before paid-beta launch.
# SECURITY WARNING: Webhook alerts must NOT include credentials, API keys,
# database connection URLs, authorization headers, cookies, or PII.
SLACK_WEBHOOK_URL=

# Override flag to allow mutating/risky QA scripts to run against the production database/env (set to "true" only if required).
ALLOW_PRODUCTION_QA_MUTATION=

# Nightly attribution parallelism (1–8, default 4). Raise only after monitoring
# confirms PostHog rate-limit headroom.
NIGHTLY_CONCURRENCY=4

NODE_ENV=production

# ── Managed proxy edge (BunnyCDN) ─────────────────────────────────────────────
# Self-serve custom tracking domains. At verify time the backend registers the
# customer hostname on the Bunny pull zone and issues a free Let's Encrypt cert.
# SERVER-SIDE ONLY — BUNNY_API_KEY is account-scoped; it is sent only in the
# Bunny AccessKey header and must NEVER be exposed to the client, logged, or
# returned in an API response. If either var below is unset the edge automation
# is DISABLED (fails closed; hostnames/certs must then be added in Bunny by hand).
BUNNY_API_KEY=
# Numeric Bunny pull-zone id that customer hostnames attach to.
BUNNY_PULL_ZONE_ID=
# CNAME target customers point their subdomain at. NOTE FOR FOUNDER: the proven
# working target this session was the Bunny pull-zone host <zone>.b-cdn.net, NOT
# the placeholder default `proxy.sourcetrack.io` — set this to the real Bunny
# zone host in staging/prod. Required in production (boot fails without it).
ST_MANAGED_PROXY_TARGET=

# ── Frontend (VITE_* — exposed to the dashboard build) ────────────────────────
# These must be prefixed with VITE_ to be available in dashboard/src via
# import.meta.env. Set in the dashboard Railway service environment.
VITE_FRONTEND_URL=
VITE_API_URL=
VITE_TRACKER_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
